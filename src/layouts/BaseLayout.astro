---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import {
  defaultLocale,
  getUi,
  localeMeta,
  locales,
  localizePath,
  resolveLocale,
  stripLocalePrefix,
} from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Distinctive section backdrop. Maps uses its own Earth hero instead. */
  theme?:
    | 'home'
    | 'wildlife'
    | 'wildlife-detail'
    | 'innovations'
    | 'innovations-detail'
    | 'solutions'
    | 'forests'
    | 'law'
    | 'law-detail'
    | 'geoengineering'
    | 'geoengineering-detail';
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const meta = localeMeta[locale];

const {
  title = ui.meta.defaultTitle,
  description = ui.meta.defaultDescription,
  image = '/images/og-meadow.jpg',
  theme,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const pagePath = stripLocalePrefix(Astro.url.pathname);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/brand/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />
    <meta name="author" content="Aigars Abramovics" />
    <meta name="generator" content={Astro.generator} />

    {
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={localeMeta[code].hreflang}
          href={new URL(localizePath(pagePath, code), site.url).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath(pagePath, defaultLocale), site.url).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      locales
        .filter((code) => code !== locale)
        .map((code) => (
          <meta property="og:locale:alternate" content={localeMeta[code].ogLocale} />
        ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={theme ? `theme-${theme}` : undefined}>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var cookie = 'fp-locale';
        var prefixed = { ru: 1, pl: 1, lv: 1 };
        var path = location.pathname;
        var first = path.split('/').filter(Boolean)[0];
        var saved;
        try {
          saved = localStorage.getItem(cookie);
        } catch (e) {}
        if (!saved) {
          var match = document.cookie.match(/(?:^|; )fp-locale=([^;]+)/);
          saved = match ? decodeURIComponent(match[1]) : '';
        }
        if (first && prefixed[first]) {
          try {
            localStorage.setItem(cookie, first);
          } catch (e) {}
        } else if (path === '/' && saved && prefixed[saved]) {
          location.replace('/' + saved + '/');
        }
      })();
    </script>
  </body>
</html>
