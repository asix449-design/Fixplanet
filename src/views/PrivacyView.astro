---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPrivacyPage, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const page = getPrivacyPage(locale);
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <header class="page-hero">
    <div class="wrap">
      <h1>{page.title}</h1>
      <p>{page.updated}</p>
    </div>
  </header>
  <div class="section">
    <div class="wrap prose">
      {
        page.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>
                {paragraph.map((part) =>
                  typeof part === 'string' ? (
                    part
                  ) : part.href.startsWith('http') ? (
                    <a href={part.href} rel="noopener noreferrer">{part.text}</a>
                  ) : (
                    <a href={part.href}>{part.text}</a>
                  ),
                )}
              </p>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
