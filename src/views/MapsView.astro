---
import MapCard from '../components/MapCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isMapCategory, mapCategoryKeys, mapCategoryPath, type MapCategory } from '../data/maps';
import { getMaps, getMapsByCategory, getMapsPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  category?: MapCategory | 'all';
}

const locale = resolveLocale(Astro.currentLocale);
const page = getMapsPage(locale);
const requested = Astro.props.category ?? Astro.url.searchParams.get('category') ?? 'all';
const activeCategory: MapCategory | 'all' =
  requested === 'all' || !requested
    ? 'all'
    : isMapCategory(requested)
      ? requested
      : 'all';

const maps = activeCategory === 'all' ? getMaps(locale) : getMapsByCategory(locale, activeCategory);
const filters = [
  { key: 'all' as const, label: page.all, href: localizePath('/maps', locale) },
  ...mapCategoryKeys.map((key) => ({
    key,
    label: page.categories[key],
    href: localizePath(mapCategoryPath(key), locale),
  })),
];
---

<BaseLayout title={page.metaTitle} description={page.metaDescription} image="/images/maps/blue-marble.jpg">
  <header class="maps-hero" aria-labelledby="maps-heading">
    <div class="maps-hero-media" aria-hidden="true">
      <img src="/images/maps/blue-marble.jpg" alt="" width="5400" height="2700" />
    </div>
    <div class="maps-hero-shade"></div>
    <div class="wrap maps-hero-copy">
      <div class="eyebrow maps-eyebrow">{page.eyebrow}</div>
      <h1 id="maps-heading">{page.title}</h1>
      <p>{page.lead}</p>
    </div>
  </header>

  <section class="section maps-catalog">
    <div class="wrap">
      <nav class="filters maps-filters" aria-label={page.filterAria}>
        {
          filters.map((filter) => (
            <a
              class:list={['filter-btn', { 'is-active': filter.key === activeCategory }]}
              href={filter.href}
              data-map-filter={filter.key}
            >
              {filter.label}
            </a>
          ))
        }
      </nav>
      {
        maps.length === 0 ? (
          <p class="wildlife-tab-lead">{page.empty}</p>
        ) : (
          <div class="card-grid cols-3" id="maps-grid">
            {maps.map((item) => (
              <MapCard map={item} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
