---
import HubTile from '../components/HubTile.astro';
import MapCard from '../components/MapCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  isMapCategory,
  mapCategoryKeys,
  mapCategoryPath,
  mapHub,
  mapsHubBackdrop,
  mapsHubSrc,
  type MapCategory,
} from '../data/maps';
import { getMapsByCategory, getMapsPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  hub?: boolean;
  category?: MapCategory;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getMapsPage(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.category ?? Astro.url.searchParams.get('category');
const activeCategory: MapCategory | undefined = hub
  ? undefined
  : isMapCategory(requested ?? undefined)
    ? requested
    : undefined;

const maps = activeCategory ? getMapsByCategory(locale, activeCategory) : [];
const filters = mapCategoryKeys.map((key) => ({
  key,
  label: page.categories[key],
  href: localizePath(mapCategoryPath(key), locale),
}));
const shelfTitle = activeCategory ? page.categories[activeCategory] : page.title;
const shelfLede = activeCategory ? page.tiles[activeCategory] : page.lead;
const shelfEyebrow =
  (activeCategory && page.categoryEyebrows[activeCategory]) || page.eyebrow;
const pageTitle = hub ? page.metaTitle : `${shelfTitle} — ${page.title} — Fix Planet`;
---

<BaseLayout
  title={pageTitle}
  description={page.metaDescription}
  image={hub ? mapsHubSrc : '/images/maps/blue-marble.jpg'}
  theme={hub ? 'maps' : undefined}
>
  {
    hub && (
      <div class="section-backdrop maps-hub-backdrop" aria-hidden="true">
        <img
          src={mapsHubSrc}
          alt=""
          width={mapsHubBackdrop.width}
          height={mapsHubBackdrop.height}
        />
        <div class="section-backdrop-scrim maps-hub-scrim"></div>
      </div>
    )
  }
  {
    !hub && (
      <header class="maps-hero" aria-labelledby="maps-heading">
        <div class="maps-hero-media" aria-hidden="true">
          <img src="/images/maps/blue-marble.jpg" alt="" width="5400" height="2700" />
        </div>
        <div class="maps-hero-shade"></div>
        <div class="wrap maps-hero-copy">
          <p>
            <a class="maps-back" href={localizePath('/maps', locale)}>{page.back}</a>
          </p>
          <div class="eyebrow maps-eyebrow">{shelfEyebrow}</div>
          <h1 id="maps-heading">{shelfTitle}</h1>
          <p>{shelfLede}</p>
        </div>
      </header>
    )
  }

  {
    hub ? (
      <section class="maps-hub-hero" aria-label={page.filterAria}>
        <div class="wrap maps-hub-hero-inner">
          <div class="maps-hub-hero-panel">
            <p class="visually-hidden">{page.hubHeroAlt}</p>
            <p class="forests-hero-kicker">{page.eyebrow}</p>
            <h1 class="forests-hero-title">{page.title}</h1>
            <p class="forests-hero-note">{page.lead}</p>
            <p class="oceans-hero-credit">{page.photoCredit}</p>
          </div>
          <nav class="hub-grid maps-hub-hero-tiles" aria-label={page.filterAria}>
            {mapHub.map((item) => (
              <HubTile
                href={localizePath(mapCategoryPath(item.key), locale)}
                icon={item.icon}
                title={page.categories[item.key]}
                text={page.tiles[item.key]}
                lead={item.lead === true}
                badge={
                  item.key === 'history-of-borders' || item.key === 'religious'
                    ? page.centuryBadge
                    : undefined
                }
                badgeTone={
                  item.key === 'history-of-borders' || item.key === 'religious' ? 'atlas' : 'soon'
                }
              />
            ))}
          </nav>
        </div>
      </section>
    ) : (
      <section class="section maps-catalog">
        <div class="wrap">
          <nav class="filters maps-filters" aria-label={page.filterAria}>
            {filters.map((filter) => (
              <a
                class:list={['filter-btn', { 'is-active': filter.key === activeCategory }]}
                href={filter.href}
              >
                {filter.label}
              </a>
            ))}
          </nav>
          {maps.length === 0 ? (
            <p class="wildlife-tab-lead">{page.empty}</p>
          ) : (
            <div class="card-grid cols-3" id="maps-grid">
              {maps.map((item) => (
                <MapCard map={item} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>
