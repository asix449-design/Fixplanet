---
import RemittanceCards from '../components/RemittanceCards.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hubBackdrop } from '../data/migration';
import { getMigrationPage, getRemittances, localizePath, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const page = getMigrationPage(locale);
const shelf = getRemittances(locale);
---

<BaseLayout
  title={`${shelf.title} — ${page.title} — Fix Planet`}
  description={page.metaDescription}
  image={hubBackdrop.file}
  theme="migration"
>
  <ShelfHeader
    backHref={localizePath('/migration', locale)}
    backLabel={page.back}
    title={shelf.title}
  />
  <section class="section section-hub-follow" id="remittances">
    <div class="wrap">
      <RemittanceCards />
    </div>
  </section>
</BaseLayout>
