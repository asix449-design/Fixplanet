---
import ComingSoon from '../components/ComingSoon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReligionHistoryPage, localizePath, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const page = getReligionHistoryPage(locale);
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <p class="wrap religion-soon-back">
    <a class="maps-back" href={localizePath('/maps', locale)}>{page.back}</a>
  </p>
  <ComingSoon title={page.title} summary={page.soonNotice} />
</BaseLayout>
