---
import CitedSourceList from '../components/CitedSourceList.astro';
import OceanRelated from '../components/OceanRelated.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  oceanAtlasLandCredit,
  oceanAtlasPreviewSrc,
  type OceanAtlasSlug,
} from '../data/ocean-atlas';
import { oceanBackdrop, oceanFrameSrc } from '../data/oceans';
import {
  getMapsPage,
  getOceanAtlasBySlug,
  getOceansPage,
  localizePath,
  oceanAtlasSectionLabels,
  resolveLocale,
} from '../i18n';
import { oceanBlueSectionLabels } from '../i18n/ocean-blue';
import { realMapCredit } from '../i18n/real-map-credits';

interface Props {
  slug: OceanAtlasSlug;
}

const locale = resolveLocale(Astro.currentLocale);
const oceans = getOceansPage(locale);
const maps = getMapsPage(locale);
const map = getOceanAtlasBySlug(locale, Astro.props.slug);
if (!map) {
  throw new Error(`Unknown oceans atlas slug: ${Astro.props.slug}`);
}
const rich = Boolean(map.caption && map.credit && map.limits && map.what && map.why && map.howToRead);
const headings = oceanBlueSectionLabels[locale];
const preview = oceanAtlasPreviewSrc(map.preview);
const credit = realMapCredit(locale, map.slug);
const art = map.detail ? oceanAtlasPreviewSrc(map.detail) : preview;
const artWidth = map.detail ? 7200 : rich ? 1920 : 1600;
const artHeight = map.detail ? 3600 : rich ? 1080 : 800;
const backdropSrc = oceanFrameSrc(oceanBackdrop.file);
const pageTitle = rich
  ? `${map.title}, ${oceans.title}, Fix Planet`
  : `${map.title} — ${oceans.title} — Fix Planet`;
const urlPattern = /(https?:\/\/[^\s)]+)/g;
const creditParts = map.credit ? map.credit.split(urlPattern) : [];
---

<BaseLayout
  title={pageTitle}
  description={map.blurb}
  image={preview}
  theme="oceans"
>
  <div class="section-backdrop" aria-hidden="true">
    <img src={backdropSrc} alt="" width="1920" height="1078" />
    <div class="section-backdrop-scrim oceans-scrim"></div>
  </div>

  <ShelfHeader
    backHref={localizePath('/oceans', locale)}
    backLabel={oceans.back}
    title={map.title}
    lede={map.blurb}
  >
    <p class="shelf-page-source">{map.meta}</p>
  </ShelfHeader>

  <section class="section section-hub-follow">
    <div class="wrap">
      <div class="wildlife-map-panel forests-panel oceans-panel">
        <figure class:list={['map-detail-art', 'forest-map-art', { 'ocean-blue-figure': rich }]}>
          <img src={art} alt={rich && map.caption ? map.caption : map.blurb} width={artWidth} height={artHeight} />
          <figcaption>
            {
              rich ? (
                <>
                  <p>{map.caption}</p>
                  <p>
                    {creditParts.map((part) =>
                      part.startsWith('http') ? (
                        <a href={part} rel="noopener noreferrer">{part}</a>
                      ) : (
                        part
                      ),
                    )}
                  </p>
                </>
              ) : credit ? (
                credit
              ) : (
                <>
                  {map.sourceOrg}. {maps.schematicNote}
                  {map.usesCoastline ? <><br />{oceanAtlasLandCredit}</> : null}
                </>
              )
            }
          </figcaption>
        </figure>
        <div class="prose map-detail-copy forest-frame-copy">
          {
            rich ? (
              <>
                <h2>{headings.what}</h2>
                <p>{map.what}</p>
                <h2>{headings.why}</h2>
                <p>{map.why}</p>
                <h2>{headings.how}</h2>
                <p>{map.howToRead}</p>
                <h2>{headings.limits}</h2>
                <p>{map.limits}</p>
                <h2>{maps.sourcesList}</h2>
                <ol class="law-source-list cited-source-list ocean-blue-sources">
                  {map.sources.map((source) => (
                    <li>
                      {source.label}
                      {': '}
                      <a href={source.url} rel="noopener noreferrer">{source.url}</a>
                    </li>
                  ))}
                </ol>
              </>
            ) : map.what && map.why && map.howToRead ? (
              <>
                <h2>{oceanAtlasSectionLabels.what}</h2>
                <p>{map.what}</p>
                <h2>{map.whyHeading ?? oceanAtlasSectionLabels.why}</h2>
                <p>{map.why}</p>
                <h2>{oceanAtlasSectionLabels.how}</h2>
                <p>{map.howToRead}</p>
                <CitedSourceList heading={maps.sourcesList} sources={map.sources} />
                <p class="oceans-cta-row">
                  <a class="btn btn-primary map-open-source" href={map.sourceUrl} rel="noopener noreferrer">
                    {maps.openSource}
                  </a>
                </p>
              </>
            ) : (
              <>
                <p>{map.detailShort}</p>
                <CitedSourceList heading={maps.sourcesList} sources={map.sources} />
                <p class="oceans-cta-row">
                  <a class="btn btn-primary map-open-source" href={map.sourceUrl} rel="noopener noreferrer">
                    {maps.openSource}
                  </a>
                </p>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {rich ? null : <OceanRelated currentAtlas={map.slug} />}
</BaseLayout>
