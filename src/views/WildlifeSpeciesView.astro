---
import CitedSourceList from '../components/CitedSourceList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { wildlifeImageSrc, type Species } from '../data/wildlife';
import { getUi, localizePath, resolveLocale } from '../i18n';

interface Props {
  species: Species;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const { species } = Astro.props;
const title = `${species.commonName} — Fix Planet`;
const image = wildlifeImageSrc(species.image);
const clickableSources = species.sourcesList?.length
  ? species.sourcesList
  : (species.primarySources ?? []);
const artWidth = species.image.width ?? 1280;
const artHeight = species.image.height ?? 960;
const licenseLabel = species.licenseLabel ?? species.image.license;
const heads =
  species.status === 'birds' ? ui.wildlifePage.birdsHeadings : ui.wildlifePage;
---

<BaseLayout title={title} description={species.hook} image={image} theme="wildlife-detail">
  <div class="section-backdrop section-backdrop-subtle" aria-hidden="true">
    <img
      src="/images/wildlife/wildlife-section-bg.jpg"
      alt=""
      width="1536"
      height="1024"
    />
    <div class="section-backdrop-scrim"></div>
  </div>
  <header class="wildlife-page-hero wildlife-page-hero-detail" aria-labelledby="species-heading">
    <div class="wildlife-page-hero-media" aria-hidden="true">
      <img
        src="/images/wildlife/wildlife-section-bg.jpg"
        alt=""
        width="1536"
        height="1024"
      />
    </div>
    <div class="wildlife-page-hero-shade"></div>
    <div class="wrap wildlife-page-hero-copy">
      <p>
        <a class="maps-back" href={localizePath('/wildlife', locale)}
          >{ui.wildlifePage.back}</a
        >
      </p>
      <div class="eyebrow wildlife-on-dark">{ui.wildlifePage.status[species.status]}</div>
      <h1 id="species-heading">{species.commonName}</h1>
      <p class="scientific-kicker"><em>{species.scientificName}</em></p>
    </div>
  </header>

  <section class="section">
    <div class="wrap wildlife-detail">
      <figure
        class:list={[
          'wildlife-detail-art',
          species.image.fit === 'natural' && 'wildlife-detail-natural',
        ]}
      >
        <img src={image} alt={species.imageAlt} width={artWidth} height={artHeight} />
        <figcaption>
          {species.caption ? <p>{species.caption}</p> : null}
          {
            species.photoCredit ? (
              <p>
                {species.photoCredit}
                {
                  species.licenseUrl ? (
                    <>
                      {' '}
                      <a href={species.licenseUrl} rel="noopener noreferrer">{licenseLabel}</a>.
                    </>
                  ) : species.filePageLabel || !licenseLabel || !species.image.sourceUrl ? null : (
                    <>
                      {' '}
                      (<a href={species.image.sourceUrl} rel="noopener noreferrer">{licenseLabel}</a>)
                    </>
                  )
                }
                {
                  species.filePageLabel && species.image.sourceUrl ? (
                    <>
                      {' '}
                      {species.filePageLabel}:{' '}
                      <a href={species.image.sourceUrl} rel="noopener noreferrer">
                        {species.image.sourceUrl}
                      </a>
                    </>
                  ) : null
                }
              </p>
            ) : species.image.sourceUrl ? (
              <>
                {ui.wildlifePage.imageCredit}: {species.image.credit}
                {
                  licenseLabel ? (
                    <>
                      {' '}
                      (<a href={species.image.sourceUrl} rel="noopener noreferrer">{licenseLabel}</a>)
                    </>
                  ) : null
                }
              </>
            ) : licenseLabel ? (
              <>
                {ui.wildlifePage.imageCredit}: {species.image.credit} ({licenseLabel})
              </>
            ) : species.caption ? null : (
              species.image.credit
            )
          }
        </figcaption>
      </figure>
      <div class="prose wildlife-prose">
        <div class="meta-row">
          <span class:list={['pill', `status-${species.status}`]}>
            {ui.wildlifePage.status[species.status]}
          </span>
          {
            species.statusPill ? (
              <span class="pill">{species.statusPill}</span>
            ) : species.iucn ? (
              <span class="pill">
                {ui.wildlifePage.iucnLabel}: {species.iucn} · {ui.wildlifePage.iucn[species.iucn]}
              </span>
            ) : null
          }
          {
            species.functionallyExtinct ? (
              <span class="pill status-extinct">{ui.wildlifePage.functionallyExtinct}</span>
            ) : null
          }
        </div>
        <h2>{heads.what}</h2>
        <p>{species.what}</p>
        <h2>{heads.range}</h2>
        <p>{species.range}</p>
        <h2>{heads.story}</h2>
        <p>{species.story}</p>
        <h2>{heads.when}</h2>
        <p>{species.when}</p>
        <h2>{heads.humanRole}</h2>
        <p>{species.humanRole}</p>
        {
          clickableSources.length ? (
            <CitedSourceList
              heading={ui.wildlifePage.sourcesLabel}
              note={species.sources}
              sources={clickableSources}
            />
          ) : (
            <>
              <h2>{ui.wildlifePage.sourcesLabel}</h2>
              <p class="wildlife-sources">{species.sources}</p>
            </>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
