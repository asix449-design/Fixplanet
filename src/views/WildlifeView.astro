---
import HubTile from '../components/HubTile.astro';
import HumanDispersalMap from '../components/HumanDispersalMap.astro';
import SectionHub from '../components/SectionHub.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import WildlifeCard from '../components/WildlifeCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  humanHeroImage,
  isWildlifeHubKey,
  isWildlifeStatus,
  wildlifeHub,
  wildlifeHubPath,
  wildlifeImageSrc,
  type WildlifeHubKey,
  type WildlifeStatus,
} from '../data/wildlife';
import { getUi, getWildlifeByStatus, localizePath, resolveLocale } from '../i18n';

interface Props {
  hub?: boolean;
  shelf?: WildlifeHubKey;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const hub = Astro.props.hub === true;
const requested =
  Astro.props.shelf ??
  Astro.url.searchParams.get('shelf') ??
  Astro.url.searchParams.get('status');
const activeShelf: WildlifeHubKey | undefined =
  hub || !isWildlifeHubKey(requested ?? undefined) ? undefined : requested;
const activeStatus: WildlifeStatus | undefined =
  activeShelf && isWildlifeStatus(activeShelf) ? activeShelf : undefined;
const isHumanShelf = activeShelf === 'homo-sapiens';

const species = activeStatus ? getWildlifeByStatus(locale, activeStatus) : [];
const tabLeads = {
  surviving: ui.wildlifePage.survivingLead,
  endangered: ui.wildlifePage.endangeredLead,
  extinct: ui.wildlifePage.extinctLead,
} as const;

const pageTitle = isHumanShelf
  ? `${ui.wildlifePage.scientificName} — Fix Planet`
  : activeStatus
    ? `${ui.wildlifePage[activeStatus]} — ${ui.wildlifePage.title} — Fix Planet`
    : ui.wildlifePage.metaTitle;
const pageDescription = isHumanShelf
  ? ui.wildlifePage.mapLead
  : activeStatus
    ? tabLeads[activeStatus]
    : ui.wildlifePage.metaDescription;
const humanHref = localizePath(wildlifeHubPath('homo-sapiens'), locale);
const wildlifeHref = localizePath('/wildlife', locale);
---

<BaseLayout title={pageTitle} description={pageDescription} theme="wildlife">
  <div class="section-backdrop" aria-hidden="true">
    <img
      src="/images/wildlife/wildlife-section-bg.jpg"
      alt=""
      width="1536"
      height="1024"
    />
    <div class="section-backdrop-scrim"></div>
  </div>

  {
    hub ? (
      <SectionHub kicker={ui.wildlifePage.chooseStatus} label={ui.wildlifePage.tabsAria} columns={4}>
        {wildlifeHub.map((item) => (
          <HubTile
            href={localizePath(wildlifeHubPath(item.key), locale)}
            icon={item.icon}
            title={ui.wildlifePage[item.key]}
            text={ui.wildlifePage.tiles[item.key]}
          />
        ))}
      </SectionHub>
    ) : activeStatus ? (
      <ShelfHeader
        backHref={wildlifeHref}
        backLabel={ui.wildlifePage.back}
        title={ui.wildlifePage[activeStatus]}
        lede={tabLeads[activeStatus]}
      />
    ) : isHumanShelf ? (
      <div class="shelf-page">
        <div class="wrap">
          <p class="shelf-page-back">
            <a class="maps-back" href={wildlifeHref}>{ui.wildlifePage.back}</a>
          </p>
        </div>
      </div>
    ) : null
  }

  {
    isHumanShelf && (
      <>
        <section class="section section-hub-follow" aria-labelledby="our-species">
          <div class="wrap wildlife-hero">
            <figure class="wildlife-hero-art">
              <img
                src={wildlifeImageSrc(humanHeroImage)}
                alt={ui.wildlifePage.imageAlt}
                width="1280"
                height="960"
              />
            </figure>
            <div class="wildlife-copy-card">
              <div class="eyebrow">{ui.wildlifePage.heroEyebrow}</div>
              <h1 id="our-species"><em>{ui.wildlifePage.scientificName}</em></h1>
              <dl class="wildlife-stats">
                <div>
                  <dt>{ui.wildlifePage.appearedLabel}</dt>
                  <dd>{ui.wildlifePage.appeared}</dd>
                </div>
                <div>
                  <dt>{ui.wildlifePage.populationLabel}</dt>
                  <dd>{ui.wildlifePage.population}</dd>
                </div>
              </dl>
              <p class="wildlife-framing">{ui.wildlifePage.framing}</p>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="dispersal-heading">
          <div class="wrap">
            <div class="wildlife-map-panel">
              <HumanDispersalMap />
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    activeStatus && (
      <section class="section section-hub-follow" id="species-list">
        <div class="wrap wildlife-list-panel">
          <div class="card-grid cols-3" id="wildlife-grid">
            {species.map((item) => (
              <WildlifeCard species={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    !isHumanShelf && (
      <script define:vars={{ humanHref }}>
        function redirectHumanAnchors() {
          const hash = window.location.hash;
          if (hash === '#our-species' || hash === '#dispersal-heading') {
            window.location.replace(humanHref + hash);
          }
        }
        redirectHumanAnchors();
        window.addEventListener('hashchange', redirectHumanAnchors);
      </script>
    )
  }
</BaseLayout>
