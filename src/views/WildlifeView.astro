---
import HubTile from '../components/HubTile.astro';
import HumanDispersalMap from '../components/HumanDispersalMap.astro';
import SectionHub from '../components/SectionHub.astro';
import WildlifeCard from '../components/WildlifeCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  humanHeroImage,
  isWildlifeStatus,
  wildlifeHub,
  wildlifeImageSrc,
  wildlifeStatusPath,
  type WildlifeStatus,
} from '../data/wildlife';
import { getUi, getWildlifeByStatus, localizePath, resolveLocale } from '../i18n';

interface Props {
  hub?: boolean;
  status?: WildlifeStatus;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.status ?? Astro.url.searchParams.get('status');
const activeStatus: WildlifeStatus | undefined =
  hub || !isWildlifeStatus(requested ?? undefined) ? undefined : requested;

const species = activeStatus ? getWildlifeByStatus(locale, activeStatus) : [];
const tabLeads = {
  surviving: ui.wildlifePage.survivingLead,
  endangered: ui.wildlifePage.endangeredLead,
  extinct: ui.wildlifePage.extinctLead,
} as const;
---

<BaseLayout
  title={ui.wildlifePage.metaTitle}
  description={ui.wildlifePage.metaDescription}
  theme="wildlife"
>
  <div class="section-backdrop" aria-hidden="true">
    <img
      src="/images/wildlife/wildlife-section-bg.jpg"
      alt=""
      width="1536"
      height="1024"
    />
    <div class="section-backdrop-scrim"></div>
  </div>

  <SectionHub kicker={ui.wildlifePage.chooseStatus} label={ui.wildlifePage.tabsAria} columns={3}>
    {
      wildlifeHub.map((item) => (
        <HubTile
          href={localizePath(wildlifeStatusPath(item.key), locale)}
          icon={item.icon}
          title={ui.wildlifePage[item.key]}
          text={ui.wildlifePage.tiles[item.key]}
          active={item.key === activeStatus}
        />
      ))
    }
  </SectionHub>

  {
    hub && (
      <>
        <section class="section section-hub-follow" aria-labelledby="our-species">
          <div class="wrap wildlife-hero">
            <figure class="wildlife-hero-art">
              <img
                src={wildlifeImageSrc(humanHeroImage)}
                alt={ui.wildlifePage.imageAlt}
                width="1280"
                height="960"
              />
            </figure>
            <div class="wildlife-copy-card">
              <div class="eyebrow">{ui.wildlifePage.heroEyebrow}</div>
              <h2 id="our-species"><em>{ui.wildlifePage.scientificName}</em></h2>
              <dl class="wildlife-stats">
                <div>
                  <dt>{ui.wildlifePage.appearedLabel}</dt>
                  <dd>{ui.wildlifePage.appeared}</dd>
                </div>
                <div>
                  <dt>{ui.wildlifePage.populationLabel}</dt>
                  <dd>{ui.wildlifePage.population}</dd>
                </div>
              </dl>
              <p class="wildlife-framing">{ui.wildlifePage.framing}</p>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="dispersal-heading">
          <div class="wrap">
            <div class="wildlife-map-panel">
              <HumanDispersalMap />
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    !hub && activeStatus && (
      <section class="section section-hub-follow" id="species-list">
        <div class="wrap wildlife-list-panel">
          <p class="wildlife-tab-lead wildlife-tab-lead-solo">{tabLeads[activeStatus]}</p>
          <div class="card-grid cols-3" id="wildlife-grid">
            {species.map((item) => (
              <WildlifeCard species={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
