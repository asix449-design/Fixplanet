---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  lawCategoryPath,
  lawDetailPath,
  lawImageSrc,
  lawSectionSrc,
  type LawEntry,
} from '../data/law';
import { getLawPage, getRelatedLaws, localizePath, resolveLocale } from '../i18n';

interface Props {
  item: LawEntry;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getLawPage(locale);
const { item } = Astro.props;
const title = `${item.title} — Fix Planet`;
const image = lawImageSrc(item.image);
const categoryHref = localizePath(lawCategoryPath(item.category), locale);
const birdsHref = localizePath(lawDetailPath('birds-directive'), locale);
const related = getRelatedLaws(locale, item.slug);
const naturalFigure = Boolean(item.image.width && item.image.height);
const cleanedShelf = item.category === 'ai' || item.category === 'ecology';
const ideaBanner = cleanedShelf ? page.aiIdeaBanner : page.ideaBanner;
const pendingBanner = cleanedShelf ? page.aiPendingBanner : page.pendingBanner;

/** Longest first so inflected forms win over a shorter stem. */
const birdsPhrases = [
  'Директивой о птицах',
  'Директиву о птицах',
  'Директива о птицах',
  'dyrektywą ptasią',
  'dyrektywę ptasią',
  'Dyrektywa ptasia',
  'Putnu direktīvu',
  'Putnu direktīva',
  'Birds Directive',
];

function escapeHtml(value: string): string {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

/** Habitats keeps its wording and, on this page, links the Birds Directive mention. */
function linkedPlain(value: string): string {
  if (item.slug !== 'habitats-directive') return escapeHtml(value);
  const phrase = birdsPhrases.find((candidate) => value.includes(candidate));
  if (!phrase) return escapeHtml(value);
  const index = value.indexOf(phrase);
  return (
    escapeHtml(value.slice(0, index)) +
    `<a href="${escapeHtml(birdsHref)}">${escapeHtml(phrase)}</a>` +
    escapeHtml(value.slice(index + phrase.length))
  );
}
---

<BaseLayout
  title={title}
  description={item.hook}
  image={image}
  theme="law-detail"
>
  <div class="section-backdrop section-backdrop-subtle" aria-hidden="true">
    <img src={lawSectionSrc} alt="" width="1920" height="1280" />
    <div class="section-backdrop-scrim law-scrim"></div>
  </div>
  <header
    class="wildlife-page-hero wildlife-page-hero-detail law-page-hero"
    aria-labelledby="law-heading"
  >
    <div class="wildlife-page-hero-media law-hero-media" aria-hidden="true">
      <img src={lawSectionSrc} alt="" width="1920" height="1280" />
    </div>
    <div class="wildlife-page-hero-shade law-hero-shade"></div>
    <div class="wrap wildlife-page-hero-copy">
      <p>
        <a class="maps-back" href={localizePath('/law', locale)}>{page.back}</a>
        {' · '}
        <a class="maps-back" href={categoryHref}>{page.categories[item.category]}</a>
      </p>
      <div class="eyebrow wildlife-on-dark">{page.categories[item.category]}</div>
      <h1 id="law-heading">{item.title}</h1>
      <p set:html={linkedPlain(item.hook)} />
    </div>
  </header>

  <section class="section">
    <div class="wrap wildlife-detail">
      <figure class="wildlife-detail-art">
        <img
          class:list={{ 'law-figure-natural': naturalFigure }}
          src={image}
          alt={item.imageAlt}
          width={item.image.width ?? 1280}
          height={item.image.height ?? 960}
        />
        <figcaption>
          {
            item.figureCredit ? (
              <>
                {item.caption ? <span class="law-figure-caption">{item.caption}</span> : null}
                <span class="law-figure-credit">
                  {item.figureCredit}
                  {item.figureLicense ? (
                    item.figureLicenseUrl ? (
                      <>
                        {' '}
                        <a href={item.figureLicenseUrl} rel="noopener noreferrer">
                          {item.figureLicense}
                        </a>
                      </>
                    ) : (
                      <> {item.figureLicense}</>
                    )
                  ) : null}
                </span>
              </>
            ) : (
              <>
                {page.imageCredit}: {item.image.credit}
                {item.image.sourceUrl ? (
                  <>
                    {' '}
                    (
                    <a href={item.image.sourceUrl} rel="noopener noreferrer">
                      {item.image.license}
                    </a>
                    )
                  </>
                ) : (
                  <> ({item.image.license})</>
                )}
              </>
            )
          }
        </figcaption>
      </figure>
      <div class="prose wildlife-prose law-prose">
        {
          item.status === 'ideas' ? (
            <p class="law-banner law-banner-idea">{ideaBanner}</p>
          ) : item.status === 'pending' ? (
            <p class="law-banner law-banner-pending">{pendingBanner}</p>
          ) : null
        }
        <div class="meta-row">
          <span class="pill">{page.categories[item.category]}</span>
          <span class:list={['pill', `status-${item.status}`]}>
            {page.status[item.status]}
          </span>
          <span class="pill">{item.jurisdiction}</span>
        </div>
        <p>
          <strong>{page.officialLabel}:</strong> {item.officialName}
          <br />
          <strong>{page.citationLabel}:</strong> {item.citation}
          <br />
          <strong>{page.yearLabel}:</strong>{' '}
          <span set:html={linkedPlain(item.yearStatus)} />
        </p>
        <h2>{page.what}</h2>
        <p>{item.what}</p>
        <h2>{page.where}</h2>
        <p>{item.where}</p>
        <h2>{page.effects}</h2>
        <p>{item.effects}</p>
        <h2>{page.caveats}</h2>
        <p set:html={linkedPlain(item.caveats)} />
        <h2>{page.sourcesLabel}</h2>
        <p class="wildlife-sources">{item.sourcesNote}</p>
        <ul class="law-source-list">
          {
            (item.sources ?? []).map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer">
                  {source.label}
                </a>
              </li>
            ))
          }
        </ul>
        {
          related.length > 0 ? (
            <>
              <h2>{page.related}</h2>
              <ul class="law-related">
                {related.map((entry) => (
                  <li>
                    <a href={localizePath(lawDetailPath(entry.slug), locale)}>{entry.title}</a>
                  </li>
                ))}
              </ul>
            </>
          ) : null
        }
      </div>
    </div>
  </section>
</BaseLayout>
