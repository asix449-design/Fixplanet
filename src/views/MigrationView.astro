---
import CitedSourceList from '../components/CitedSourceList.astro';
import DisplacementGlobe from '../components/DisplacementGlobe.astro';
import HubTile from '../components/HubTile.astro';
import HumanEraAtlas from '../components/HumanEraAtlas.astro';
import HumanMapLinkCard from '../components/HumanMapLinkCard.astro';
import InternalDisplacement from '../components/InternalDisplacement.astro';
import MigrationCard from '../components/MigrationCard.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  hubBackdrop,
  humanHeroImage,
  humanSources,
  isMigrationShelf,
  migrationHub,
  migrationImageSrc,
  migrationShelfPath,
  type MigrationShelf,
} from '../data/migration';
import { cartetikaRoundup } from '../data/human-map-links';
import {
  DISPLACEMENT_SOURCES_PATH,
  getDisplacementPage,
  getHumanMapLinks,
  getHumanMigrationEras,
  getMigrationByShelf,
  getMigrationPage,
  localizePath,
  resolveLocale,
} from '../i18n';

interface Props {
  hub?: boolean;
  shelf?: MigrationShelf;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getMigrationPage(locale);
const displacement = getDisplacementPage(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.shelf ?? Astro.url.searchParams.get('shelf');
const activeShelf: MigrationShelf | undefined = hub
  ? undefined
  : isMigrationShelf(requested ?? undefined)
    ? requested
    : 'humans';

const greatEntries =
  activeShelf === 'great-migrations' ? getMigrationByShelf(locale, 'great-migrations') : [];
const humans = page.humans;
const humanEras = getHumanMigrationEras(locale);
const humanMapLinks = activeShelf === 'humans' ? getHumanMapLinks(locale) : [];
const pageTitle = activeShelf
  ? `${page.shelves[activeShelf]} — ${page.title} — Fix Planet`
  : page.metaTitle;
const pageDescription = activeShelf ? page.shelfLeads[activeShelf] : page.metaDescription;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={hubBackdrop.file}
  theme="migration"
>
  <div class="section-backdrop" aria-hidden="true">
    <img src={hubBackdrop.file} alt="" width={hubBackdrop.width} height={hubBackdrop.height} />
    <div class="section-backdrop-scrim"></div>
  </div>

  {
    hub ? (
      <>
      <section class="mig-displace-hero" aria-label={displacement.mapLabel}>
        <DisplacementGlobe hero />
        <p class="mig-displace-link">
          <a href={localizePath(DISPLACEMENT_SOURCES_PATH, locale)}>{displacement.sourcesLink}</a>
        </p>
      </section>
      <section class="section-hub" aria-label={page.filterAria}>
        <div class="wrap home-hub-inner">
          <p class="eyebrow">{page.eyebrow}</p>
          <h1 class="home-hub-kicker">{page.title}</h1>
          <div class="encyc-lede migration-hub-lede">
            {page.hubLead.map((para) => <p>{para}</p>)}
          </div>
          <nav class="hub-grid hub-grid-2 migration-hub-tiles" aria-label={page.chooseShelf}>
            {
              migrationHub.map((item) => (
                <HubTile
                  href={localizePath(migrationShelfPath(item.key), locale)}
                  icon={item.icon}
                  title={page.hubTitles[item.key]}
                  text={page.tiles[item.key]}
                />
              ))
            }
          </nav>
        </div>
      </section>
      </>
    ) : (
      activeShelf && (
        <ShelfHeader
          backHref={localizePath('/migration', locale)}
          backLabel={page.back}
          title={page.shelves[activeShelf]}
          lede={page.shelfLeads[activeShelf]}
        />
      )
    )
  }

  {hub && <InternalDisplacement />}

  {
    activeShelf === 'humans' && (
      <>
        <section class="section section-hub-follow" aria-labelledby="human-event-heading">
          <div class="wrap">
            <div class="wildlife-map-panel">
          <HumanEraAtlas events={humanEras} atlas={humans.eventAtlas} />
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="human-map-links">
          <div class="wrap wildlife-list-panel">
            <div class="encyc-lede">
              <h2 id="human-map-links">{humans.mapLinks.title}</h2>
              <p class="human-map-links-lead">{humans.mapLinks.lead}</p>
            </div>
            <div class="card-grid cols-3">
              {humanMapLinks.map((item) => (
                <HumanMapLinkCard item={item} />
              ))}
            </div>
            <p class="human-map-listed">
              {humans.mapLinks.listedBy}{' '}
              <a href={cartetikaRoundup.url} rel="noopener noreferrer">
                {cartetikaRoundup.label}
              </a>
            </p>
          </div>
        </section>

        <section class="section" aria-labelledby="our-species">
          <div class="wrap migration-human-portrait">
            <figure class="wildlife-hero-art migration-human-figure">
              <img
                src={migrationImageSrc(humanHeroImage)}
                alt={humans.imageAlt}
                width="540"
                height="810"
              />
              <figcaption>
                {page.imageCredit}: {humanHeroImage.credit} ({humanHeroImage.license})
              </figcaption>
            </figure>
            <div class="wildlife-copy-card">
              <div class="eyebrow">{humans.heroEyebrow}</div>
              <h2 id="our-species"><em>{humans.scientificName}</em></h2>
              <dl class="wildlife-stats">
                <div>
                  <dt>{humans.appearedLabel}</dt>
                  <dd>{humans.appeared}</dd>
                </div>
                <div>
                  <dt>{humans.populationLabel}</dt>
                  <dd>{humans.population}</dd>
                </div>
              </dl>
              {humans.framing.map((para) => <p class="wildlife-framing">{para}</p>)}
              <p class="wildlife-framing">
                <a href={localizePath('/wildlife/homo-sapiens', locale)}>{humans.wildlifeCta}</a>
                {' '}
                {humans.wildlifePointer}
              </p>
              <p class="wildlife-framing">
                <a href={localizePath('/migration/great-migrations', locale)}>
                  {humans.greatMigrationsCta}
                </a>
                {' '}
                {humans.greatMigrationsNote}
              </p>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="human-drivers">
          <div class="wrap">
            <div class="wildlife-copy-card forests-panel oceans-panel">
              <div class="encyc-lede oceans-lede">
                <h2 id="human-drivers">{page.drivers}</h2>
                {
                  humans.sections.map((block) => (
                    <article class="migration-human-section">
                      <h3>{block.title}</h3>
                      <p>{block.body}</p>
                    </article>
                  ))
                }
              </div>
              <CitedSourceList heading={page.sourcesLabel} sources={humanSources} />
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    activeShelf === 'great-migrations' && (
      <section class="section section-hub-follow" id="migration-list">
        <div class="wrap wildlife-list-panel">
          <div class="card-grid cols-3">
            {greatEntries.map((item) => (
              <MigrationCard item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

</BaseLayout>

<style>
  .mig-displace-hero {
    position: relative;
    z-index: 1;
    padding: 0.15rem 0 0.15rem;
    background: #050505;
  }

  .mig-displace-link {
    width: min(1600px, calc(100% - 16px));
    margin: 0.1rem auto 0.45rem;
    text-align: right;
  }

  .mig-displace-link a {
    color: var(--lime);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .mig-displace-link a:hover {
    text-decoration: underline;
  }
</style>
