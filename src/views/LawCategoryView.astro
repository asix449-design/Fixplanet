---
import LawCard from '../components/LawCard.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  lawSectionSrc,
  lawStatusKeys,
  lawStatusPath,
  type LawCategory,
  type LawStatus,
} from '../data/law';
import { getLawPage, getLawsByCategory, localizePath, resolveLocale } from '../i18n';

interface Props {
  category: LawCategory;
  status?: LawStatus;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getLawPage(locale);
const category = Astro.props.category;
const activeStatus = Astro.props.status;
const items = getLawsByCategory(locale, category);
---

<BaseLayout
  title={page.categoryMetaTitle[category]}
  description={page.categoryMetaDescription[category]}
  image={lawSectionSrc}
  theme="law"
>
  <div class="section-backdrop" aria-hidden="true">
    <img src={lawSectionSrc} alt="" width="1920" height="1280" />
    <div class="section-backdrop-scrim law-scrim"></div>
  </div>

  <ShelfHeader
    backHref={localizePath('/law', locale)}
    backLabel={page.back}
    title={page.categories[category]}
    lede={page.categoryLeads[category]}
  />

  <section class="section section-hub-follow" id="law-shelves">
    {
      lawStatusKeys.map((status) => {
        const shelf = items.filter((item) => item.status === status);
        const highlighted = activeStatus === status;
        return (
          <div
            class:list={['wrap', 'law-shelf', { 'is-highlighted': highlighted }]}
            id={status}
            data-law-shelf={status}
          >
            <div class="law-shelf-head">
              <div>
                <a
                  class:list={['law-shelf-title', { 'is-active': highlighted }]}
                  href={localizePath(lawStatusPath(category, status), locale)}
                >
                  {page.status[status]}
                </a>
                <p>{page.statusLeads[status]}</p>
              </div>
            </div>
            {shelf.length === 0 ? (
              <p class="wildlife-tab-lead">{page.empty}</p>
            ) : (
              <div class="card-grid cols-3">
                {shelf.map((item) => (
                  <LawCard item={item} />
                ))}
              </div>
            )}
          </div>
        );
      })
    }
  </section>
</BaseLayout>

<script define:vars={{ activeStatus: activeStatus ?? '' }}>
  if (activeStatus) {
    document.getElementById(activeStatus)?.scrollIntoView({ block: 'start' });
  }
</script>
