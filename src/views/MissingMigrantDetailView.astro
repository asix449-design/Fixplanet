---
import CitedSourceList from '../components/CitedSourceList.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  linkifyUrls,
  missingMigrantChartSize,
  missingMigrantIds,
  missingMigrantSrc,
  missingMigrantsShelfSlug,
  type MissingMigrantId,
} from '../data/missing-migrants';
import {
  getMigrationPage,
  getMissingMigrant,
  getMissingMigrants,
  localizePath,
  resolveLocale,
} from '../i18n';

interface Props {
  slug: MissingMigrantId;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getMigrationPage(locale);
const shelf = getMissingMigrants(locale);
const card = getMissingMigrant(locale, Astro.props.slug);
const art = missingMigrantSrc(card.file);
const others = missingMigrantIds.filter((id) => id !== card.id);
const shelfHref = localizePath(`/migration/${missingMigrantsShelfSlug}`, locale);
---

<BaseLayout
  title={`${card.title}, ${page.title}, Fix Planet`}
  description={card.blurb}
  image={art}
  theme="migration-detail"
>
  <ShelfHeader
    backHref={shelfHref}
    backLabel={shelf.title}
    title={card.title}
    lede={card.blurb}
  >
    <p class="shelf-page-source">{card.meta}</p>
  </ShelfHeader>

  <section class="section section-hub-follow">
    <div class="wrap">
      <div class="wildlife-map-panel">
        <figure class="map-detail-art">
          <img
            src={art}
            alt={card.caption}
            width={missingMigrantChartSize.width}
            height={missingMigrantChartSize.height}
          />
          <figcaption>
            <p>{card.caption}</p>
            <p set:html={linkifyUrls(card.credit)} />
          </figcaption>
        </figure>
        <div class="prose map-detail-copy">
          {
            card.sections.map((section) => (
              <>
                <h2>{section.heading}</h2>
                <p>{section.body}</p>
              </>
            ))
          }
          <CitedSourceList heading={page.sourcesLabel} sources={card.sources} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="missing-migrants-related">
    <div class="wrap">
      <h2 id="missing-migrants-related">{shelf.title}</h2>
      <ul class="today-mig-layer-list">
        {
          others.map((id) => {
            const item = getMissingMigrant(locale, id);
            return (
              <li>
                <a href={localizePath(`/migration/${id}`, locale)}>{item.title}</a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>
