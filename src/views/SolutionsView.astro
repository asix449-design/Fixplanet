---
import HubTile from '../components/HubTile.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import SolutionCard from '../components/SolutionCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  isSolutionTag,
  solutionTagPath,
  solutionsHub,
  solutionsHubBackdrop,
  solutionsHubSrc,
  type TagKey,
} from '../data/solutions';
import { isForestEncyclopediaSlug, forestEncyclopediaPath } from '../data/solutions-forests';
import { isWaterEncyclopediaSlug, waterEncyclopediaPath } from '../data/solutions-water';
import { getSolutions, getUi, localizePath, resolveLocale } from '../i18n';

interface Props {
  hub?: boolean;
  tag?: TagKey | 'all';
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.tag ?? Astro.url.searchParams.get('tag');
const activeTag: TagKey | 'all' | undefined = hub
  ? undefined
  : requested === 'all' || !requested
    ? 'all'
    : isSolutionTag(requested)
      ? requested
      : 'all';

const solutions = getSolutions(locale).filter(
  (solution) => !activeTag || activeTag === 'all' || solution.tag === activeTag,
);
const shelfTitle =
  !activeTag || activeTag === 'all'
    ? ui.solutionsPage.all
    : ui.solutionsPage.tags[activeTag];
const pageTitle = hub
  ? ui.solutionsPage.metaTitle
  : `${shelfTitle} — ${ui.solutionsPage.title} — Fix Planet`;
---

<BaseLayout
  title={pageTitle}
  description={ui.solutionsPage.metaDescription}
  image={hub ? solutionsHubSrc : undefined}
  theme="solutions"
>
  {
    hub && (
      <div class="section-backdrop solutions-hub-backdrop" aria-hidden="true">
        <img
          src={solutionsHubSrc}
          alt=""
          width={solutionsHubBackdrop.width}
          height={solutionsHubBackdrop.height}
        />
        <div class="section-backdrop-scrim solutions-hub-scrim"></div>
      </div>
    )
  }
  {
    hub ? (
      <section class="solutions-hero" aria-label={ui.solutionsPage.filterAria}>
        <div class="wrap solutions-hero-inner">
          <div class="solutions-hero-panel">
            <p class="visually-hidden">{ui.solutionsPage.heroAlt}</p>
            <p class="forests-hero-kicker">{ui.solutionsPage.eyebrow}</p>
            <h1 class="forests-hero-title">{ui.solutionsPage.title}</h1>
            <p class="forests-hero-note">{ui.solutionsPage.lead}</p>
            <p class="oceans-hero-credit">{ui.solutionsPage.photoCredit}</p>
          </div>
          <nav class="hub-grid solutions-hero-tiles" aria-label={ui.solutionsPage.filterAria}>
            {solutionsHub.map((item) => (
              <HubTile
                href={localizePath(solutionTagPath(item.key), locale)}
                icon={item.icon}
                title={ui.solutionsPage.tags[item.key]}
                text={ui.solutionsPage.tileLeads[item.key]}
              />
            ))}
          </nav>
        </div>
      </section>
    ) : (
      <ShelfHeader
        backHref={localizePath('/solutions', locale)}
        backLabel={ui.solutionsPage.back}
        title={shelfTitle}
        lede={activeTag ? ui.solutionsPage.tileLeads[activeTag] : undefined}
      />
    )
  }

  {
    !hub && (
      <section class="section section-hub-follow solutions-cards" id="solution-list">
        <div class="wrap">
          <div class="card-grid cols-3" id="solution-grid">
            {solutions.map((solution) => (
              <SolutionCard
                solution={solution}
                href={
                  isWaterEncyclopediaSlug(solution.slug)
                    ? localizePath(waterEncyclopediaPath(solution.slug), locale)
                    : isForestEncyclopediaSlug(solution.slug)
                      ? localizePath(forestEncyclopediaPath(solution.slug), locale)
                      : localizePath(`/solutions/${solution.tag}#${solution.slug}`, locale)
                }
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
