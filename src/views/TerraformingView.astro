---
import TerraformingCard from '../components/TerraformingCard.astro';
import HubTile from '../components/HubTile.astro';
import SectionHub from '../components/SectionHub.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  geoHub,
  geoSectionSrc,
  geoShelfPath,
  isGeoShelf,
  type GeoShelf,
} from '../data/terraforming';
import {
  getGeoPage,
  getGeoProjects,
  getGeoProjectsByShelf,
  localizePath,
  resolveLocale,
} from '../i18n';

interface Props {
  hub?: boolean;
  shelf?: GeoShelf;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getGeoPage(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.shelf ?? Astro.url.searchParams.get('shelf');
const activeShelf: GeoShelf | undefined =
  hub || !isGeoShelf(requested ?? undefined) ? undefined : requested;

const items = activeShelf ? getGeoProjectsByShelf(locale, activeShelf) : getGeoProjects(locale);
const shelfTitle = activeShelf ? page.shelves[activeShelf] : page.title;
const pageTitle = activeShelf
  ? `${page.shelves[activeShelf]} — ${page.title} — Fix Planet`
  : page.metaTitle;
const pageDescription = activeShelf ? page.shelfLeads[activeShelf] : page.metaDescription;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={geoSectionSrc}
  theme="terraforming"
>
  <div class="section-backdrop" aria-hidden="true">
    <img src={geoSectionSrc} alt="" width="1920" height="1280" />
    <div class="section-backdrop-scrim geo-scrim"></div>
  </div>

  {
    hub ? (
      <SectionHub kicker={page.chooseShelf} label={page.filterAria} columns={3}>
        {geoHub.map((item) => (
          <HubTile
            href={localizePath(geoShelfPath(item.key), locale)}
            icon={item.icon}
            title={page.shelves[item.key]}
            text={page.tiles[item.key]}
          />
        ))}
      </SectionHub>
    ) : (
      <ShelfHeader
        backHref={localizePath('/terraforming', locale)}
        backLabel={page.back}
        title={shelfTitle}
        lede={activeShelf ? page.shelfLeads[activeShelf] : page.shelfLeads.all}
      />
    )
  }

  {
    !hub && (
      <section class="section section-hub-follow" id="terraforming-list">
        <div class="wrap wildlife-list-panel geo-list-panel">
          {items.length === 0 ? (
            <p class="wildlife-tab-lead">{page.empty}</p>
          ) : (
            <div class="card-grid cols-3" id="terraforming-grid">
              {items.map((item) => (
                <TerraformingCard item={item} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>
