---
import TerraformingCard from '../components/TerraformingCard.astro';
import HubTile from '../components/HubTile.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  geoHub,
  geoHubBackdrop,
  geoHubSrc,
  geoSectionSrc,
  geoShelfPath,
  isGeoShelf,
  type GeoShelf,
} from '../data/terraforming';
import {
  getGeoPage,
  getGeoProjects,
  getGeoProjectsByShelf,
  localizePath,
  resolveLocale,
} from '../i18n';

interface Props {
  hub?: boolean;
  shelf?: GeoShelf;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getGeoPage(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.shelf ?? Astro.url.searchParams.get('shelf');
const activeShelf: GeoShelf | undefined =
  hub || !isGeoShelf(requested ?? undefined) ? undefined : requested;

const items = activeShelf ? getGeoProjectsByShelf(locale, activeShelf) : getGeoProjects(locale);
const shelfTitle = activeShelf ? page.shelves[activeShelf] : page.title;
const pageTitle = activeShelf
  ? `${page.shelves[activeShelf]} — ${page.title} — Fix Planet`
  : page.metaTitle;
const pageDescription = activeShelf ? page.shelfLeads[activeShelf] : page.metaDescription;
const backdropSrc = hub ? geoHubSrc : geoSectionSrc;
const backdropWidth = hub ? geoHubBackdrop.width : 1920;
const backdropHeight = hub ? geoHubBackdrop.height : 1280;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={backdropSrc}
  theme="terraforming"
>
  <div class:list={['section-backdrop', { 'terraforming-hub-backdrop': hub }]} aria-hidden="true">
    <img src={backdropSrc} alt="" width={backdropWidth} height={backdropHeight} />
    <div class:list={['section-backdrop-scrim', 'geo-scrim', hub && 'terraforming-hub-scrim']}></div>
  </div>

  {
    hub ? (
      <section class="terraforming-hero" aria-label={page.filterAria}>
        <div class="wrap terraforming-hero-inner">
          <div class="terraforming-hero-panel">
            <p class="visually-hidden">{page.heroAlt}</p>
            <p class="forests-hero-kicker">{page.eyebrow}</p>
            <h1 class="forests-hero-title">{page.title}</h1>
            <p class="forests-hero-note">{page.lead}</p>
            <p class="oceans-hero-credit">{page.photoCredit}</p>
          </div>
          <nav class="hub-grid hub-grid-3 terraforming-hero-tiles" aria-label={page.filterAria}>
            {geoHub.map((item) => (
              <HubTile
                href={localizePath(geoShelfPath(item.key), locale)}
                icon={item.icon}
                title={page.shelves[item.key]}
                text={page.tiles[item.key]}
              />
            ))}
          </nav>
        </div>
      </section>
    ) : (
      <ShelfHeader
        backHref={localizePath('/terraforming', locale)}
        backLabel={page.back}
        title={shelfTitle}
        lede={activeShelf ? page.shelfLeads[activeShelf] : page.shelfLeads.all}
      />
    )
  }

  {
    !hub && (
      <section class="section section-hub-follow" id="terraforming-list">
        <div class="wrap wildlife-list-panel geo-list-panel">
          {items.length === 0 ? (
            <p class="wildlife-tab-lead">{page.empty}</p>
          ) : (
            <div class="card-grid cols-3" id="terraforming-grid">
              {items.map((item) => (
                <TerraformingCard item={item} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>
