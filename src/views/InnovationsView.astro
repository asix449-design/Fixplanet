---
import HubTile from '../components/HubTile.astro';
import InnovationCard from '../components/InnovationCard.astro';
import SectionHub from '../components/SectionHub.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  innovationAreaPath,
  innovationHub,
  isInnovationArea,
  type InnovationArea,
} from '../data/innovations';
import { getInnovations, getInnovationsPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  area?: InnovationArea | 'all';
}

const locale = resolveLocale(Astro.currentLocale);
const page = getInnovationsPage(locale);
const requested = Astro.props.area ?? Astro.url.searchParams.get('area') ?? 'all';
const activeArea: InnovationArea | 'all' =
  requested === 'all' || !requested
    ? 'all'
    : isInnovationArea(requested)
      ? requested
      : 'all';

const items = getInnovations(locale);
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  image="/images/innovations/innovations-section-bg.jpg"
  theme="innovations"
>
  <div class="section-backdrop" aria-hidden="true">
    <img
      src="/images/innovations/innovations-section-bg.jpg"
      alt=""
      width="1920"
      height="1280"
    />
    <div class="section-backdrop-scrim innovations-scrim"></div>
  </div>

  <SectionHub kicker={page.chooseArea} label={page.filterAria} columns={3}>
    {
      innovationHub.map((item) => (
        <HubTile
          href={localizePath(innovationAreaPath(item.key), locale)}
          icon={item.icon}
          title={page.areas[item.key]}
          text={page.tiles[item.key]}
          active={item.key === activeArea}
          dataArea={item.key}
        />
      ))
    }
  </SectionHub>

  <section class="section section-hub-follow" id="innovations-list">
    <div class="wrap wildlife-list-panel innovations-list-panel">
      <p class="wildlife-tab-lead" data-tab-lead>
        {page.areaLeads[activeArea]}
      </p>
      <div class="card-grid cols-3" id="innovations-grid">
        {
          items.map((item) => (
            <div hidden={activeArea !== 'all' && item.area !== activeArea}>
              <InnovationCard item={item} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script
  define:vars={{
    leads: page.areaLeads,
    allHref: localizePath(innovationAreaPath('all'), locale),
    ecologyHref: localizePath(innovationAreaPath('ecology'), locale),
    energyHref: localizePath(innovationAreaPath('energy'), locale),
    aiHref: localizePath(innovationAreaPath('ai'), locale),
  }}
>
  const hrefs = {
    all: allHref,
    ecology: ecologyHref,
    energy: energyHref,
    ai: aiHref,
  };

  const buttons = document.querySelectorAll('[data-area]');
  const cards = document.querySelectorAll('#innovations-grid > div');
  const lead = document.querySelector('[data-tab-lead]');

  function show(area) {
    if (!(area in hrefs)) return;
    buttons.forEach((button) => {
      const on = button.dataset.area === area;
      button.classList.toggle('is-active', on);
      if (on) button.setAttribute('aria-current', 'page');
      else button.removeAttribute('aria-current');
    });
    cards.forEach((card) => {
      const inner = card.querySelector('[data-innovation-area]');
      const itemArea = inner?.dataset.innovationArea;
      card.hidden = area !== 'all' && itemArea !== area;
    });
    if (lead && area in leads) {
      lead.textContent = leads[area];
    }
  }

  buttons.forEach((button) => {
    button.addEventListener('click', (event) => {
      const area = button.dataset.area;
      if (!area || !(area in hrefs)) return;
      event.preventDefault();
      show(area);
      history.replaceState(null, '', hrefs[area]);
      document.getElementById('innovations-list')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    });
  });

  const query = new URLSearchParams(location.search).get('area');
  if (query && query in hrefs) show(query);
</script>
