---
import HubTile from '../components/HubTile.astro';
import InnovationCard from '../components/InnovationCard.astro';
import SectionHub from '../components/SectionHub.astro';
import ShelfHeader from '../components/ShelfHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  innovationAreaPath,
  innovationHub,
  isInnovationArea,
  type InnovationArea,
} from '../data/innovations';
import {
  getInnovations,
  getInnovationsByArea,
  getInnovationsPage,
  localizePath,
  resolveLocale,
} from '../i18n';

interface Props {
  hub?: boolean;
  area?: InnovationArea;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getInnovationsPage(locale);
const hub = Astro.props.hub === true;
const requested = Astro.props.area ?? Astro.url.searchParams.get('area');
const activeArea: InnovationArea | undefined =
  hub || !isInnovationArea(requested ?? undefined) ? undefined : requested;

const items = activeArea ? getInnovationsByArea(locale, activeArea) : getInnovations(locale);
const shelfTitle = activeArea ? page.areas[activeArea] : page.title;
const pageTitle = activeArea
  ? `${page.areas[activeArea]} — ${page.title} — Fix Planet`
  : page.metaTitle;
const pageDescription = activeArea ? page.areaLeads[activeArea] : page.metaDescription;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/images/innovations/innovations-section-bg.jpg"
  theme="innovations"
>
  <div class="section-backdrop" aria-hidden="true">
    <img
      src="/images/innovations/innovations-section-bg.jpg"
      alt=""
      width="1920"
      height="1280"
    />
    <div class="section-backdrop-scrim innovations-scrim"></div>
  </div>

  {
    hub ? (
      <SectionHub kicker={page.chooseArea} label={page.filterAria} columns={3}>
        {innovationHub.map((item) => (
          <HubTile
            href={localizePath(innovationAreaPath(item.key), locale)}
            icon={item.icon}
            title={page.areas[item.key]}
            text={page.tiles[item.key]}
          />
        ))}
      </SectionHub>
    ) : (
      <ShelfHeader
        backHref={localizePath('/innovations', locale)}
        backLabel={page.back}
        title={shelfTitle}
        lede={activeArea ? page.areaLeads[activeArea] : page.areaLeads.all}
      />
    )
  }

  {
    !hub && (
      <section class="section section-hub-follow" id="innovations-list">
        <div class="wrap wildlife-list-panel innovations-list-panel">
          {items.length === 0 ? (
            <p class="wildlife-tab-lead">{page.empty}</p>
          ) : (
            <div class="card-grid cols-3" id="innovations-grid">
              {items.map((item) => (
                <InnovationCard item={item} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>
