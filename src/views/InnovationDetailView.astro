---
import CitedSourceList from '../components/CitedSourceList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { innovationImageSrc, type Innovation } from '../data/innovations';
import { getInnovationsPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  item: Innovation;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getInnovationsPage(locale);
const { item } = Astro.props;
const title =
  item.area === 'energy' ? `${item.title}, Fix Planet` : `${item.title} — Fix Planet`;
const image = innovationImageSrc(item.image);
const backLabel =
  item.area === 'energy' ? page.back.replace(/^\s*←\s*/, '') : page.back;
const quad = item.shape === 'quad';
const licenseHref = item.licenseUrl || item.image.sourceUrl;
let creditBefore = item.figureCredit ?? '';
let creditLink = '';
let creditAfter = '';
if (item.figureCredit && item.licenseLabel && item.figureCredit.includes(item.licenseLabel)) {
  const at = item.figureCredit.indexOf(item.licenseLabel);
  creditBefore = item.figureCredit.slice(0, at);
  creditLink = item.licenseLabel;
  creditAfter = item.figureCredit.slice(at + item.licenseLabel.length);
}
---

<BaseLayout
  title={title}
  description={item.hook}
  image={image}
  theme="innovations-detail"
>
  <div class="section-backdrop section-backdrop-subtle" aria-hidden="true">
    <img
      src="/images/innovations/innovations-section-bg.jpg"
      alt=""
      width="1920"
      height="1280"
    />
    <div class="section-backdrop-scrim innovations-scrim"></div>
  </div>
  <header
    class="wildlife-page-hero wildlife-page-hero-detail innovations-page-hero"
    aria-labelledby="innovation-heading"
  >
    <div class="wildlife-page-hero-media innovations-hero-media" aria-hidden="true">
      <img
        src="/images/innovations/innovations-section-bg.jpg"
        alt=""
        width="1920"
        height="1280"
      />
    </div>
    <div class="wildlife-page-hero-shade innovations-hero-shade"></div>
    <div class="wrap wildlife-page-hero-copy">
      <p>
        <a class="maps-back" href={localizePath('/innovations', locale)}>{backLabel}</a>
      </p>
      <div class="eyebrow wildlife-on-dark">{page.areas[item.area]}</div>
      <h1 id="innovation-heading">{item.title}</h1>
    </div>
  </header>

  <section class="section">
    <div class="wrap wildlife-detail">
      <figure class:list={['wildlife-detail-art', item.area === 'energy' && 'energy-figure']}>
        <img
          src={image}
          alt={item.imageAlt}
          width={item.image.width ?? 1280}
          height={item.image.height ?? 960}
        />
        <figcaption>
          {item.caption && <p>{item.caption}</p>}
          {
            item.figureCredit ? (
              <p>
                {creditBefore}
                {creditLink ? (
                  <a href={licenseHref} rel="noopener noreferrer">
                    {creditLink}
                  </a>
                ) : null}
                {creditAfter}
              </p>
            ) : (
              <p>
                {page.imageCredit}: {item.image.credit}
                {item.image.sourceUrl ? (
                  <>
                    {' '}
                    (
                    <a href={item.image.sourceUrl} rel="noopener noreferrer">
                      {item.image.license}
                    </a>
                    )
                  </>
                ) : (
                  <> ({item.image.license})</>
                )}
              </p>
            )
          }
        </figcaption>
      </figure>
      <div class="prose wildlife-prose innovations-prose">
        <div class="meta-row">
          <span class="pill">{page.areas[item.area]}</span>
          <span class:list={['pill', `status-${item.status}`]}>
            {page.status[item.status]}
          </span>
        </div>
        {
          quad ? (
            <>
              <h2>{page.what}</h2>
              <p>{item.what}</p>
              <h2>{page.why}</h2>
              <p>{item.problem}</p>
              <h2>{page.read}</h2>
              <p>{item.how}</p>
              <h2>{page.limits}</h2>
              <p>{item.risks}</p>
            </>
          ) : (
            <>
              <h2>{page.what}</h2>
              <p>{item.what}</p>
              <h2>{page.problem}</h2>
              <p>{item.problem}</p>
              <h2>{page.how}</h2>
              <p>{item.how}</p>
              <h2>{page.players}</h2>
              <p>{item.players}</p>
              <h2>{page.risks}</h2>
              <p>{item.risks}</p>
            </>
          )
        }
        <CitedSourceList
          heading={page.sourcesLabel}
          note={item.sourcesNote}
          sources={item.sources}
        />
      </div>
    </div>
  </section>
</BaseLayout>
