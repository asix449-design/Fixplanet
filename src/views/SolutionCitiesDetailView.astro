---
import CitedSourceList from '../components/CitedSourceList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  citiesEncyclopediaImageSrc,
  citiesLegendColors,
  citiesPhotoSlugs,
  type CitiesEncyclopedia,
} from '../data/solutions-cities';
import { getUi, localizePath, resolveLocale } from '../i18n';
import { citiesDetailHeadings } from '../i18n/solutions-cities';

interface Props {
  item: CitiesEncyclopedia;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const headings = citiesDetailHeadings[locale];
const { item } = Astro.props;
const photoDoorway = (citiesPhotoSlugs as readonly string[]).includes(item.slug);
const title = photoDoorway
  ? `${item.title}, ${ui.solutionsPage.tags.cities}, ${ui.solutionsPage.title}, Fix Planet`
  : `${item.title} — Fix Planet`;
const image = citiesEncyclopediaImageSrc(item.image);
const imageWidth = item.image.width ?? 1600;
const imageHeight = item.image.height ?? 1200;

type CreditBit = { text: string; href?: string };

function creditBits(): CreditBit[] {
  const credit = item.credit;
  const needles: { text: string; href: string }[] = [];
  const code = `(${item.image.license})`;
  if (item.image.license && credit.includes(code) && item.image.licenseUrl) {
    needles.push({ text: code, href: item.image.licenseUrl });
  } else if (item.image.licenseUrl) {
    const version = item.image.license.match(/(\d+\.\d+)/)?.[1];
    if (version) {
      const phrases = [
        `«Атрибуция, на тех же условиях» ${version}`,
        `Uznanie autorstwa na tych samych warunkach ${version}`,
        `«Ar autora norādi, tādos pašos noteikumos» ${version}`,
      ];
      for (const phrase of phrases) {
        if (credit.includes(phrase)) {
          needles.push({ text: phrase, href: item.image.licenseUrl });
          break;
        }
      }
    }
  }
  for (const name of ['Wikimedia Commons', 'Викисклад']) {
    if (credit.includes(name) && item.image.sourceUrl) {
      needles.push({ text: name, href: item.image.sourceUrl });
    }
  }
  const found = needles
    .map((needle) => ({ ...needle, index: credit.indexOf(needle.text) }))
    .filter((needle) => needle.index >= 0)
    .sort((a, b) => a.index - b.index);
  if (found.length === 0) return [{ text: credit }];
  const bits: CreditBit[] = [];
  let cursor = 0;
  for (const needle of found) {
    if (needle.index < cursor) continue;
    if (needle.index > cursor) bits.push({ text: credit.slice(cursor, needle.index) });
    bits.push({ text: needle.text, href: needle.href });
    cursor = needle.index + needle.text.length;
  }
  if (cursor < credit.length) bits.push({ text: credit.slice(cursor) });
  return bits;
}
const citiesHref = localizePath('/solutions/cities', locale);
const legendColors = citiesLegendColors[item.slug] ?? [];
const plate =
  item.slug === 'low-emission-zones'
    ? 'map'
    : item.slug === 'congestion-charging' || item.slug === 'electric-buses'
      ? 'chart'
      : 'photo';
---

<BaseLayout
  title={title}
  description={item.hook}
  image={image}
  theme="solutions-detail"
>
  <div class="section-backdrop section-backdrop-subtle" aria-hidden="true">
    <img
      src="/images/solutions/solutions-hub-bg.jpg"
      alt=""
      width="1280"
      height="720"
    />
    <div class="section-backdrop-scrim solutions-detail-scrim"></div>
  </div>
  <header
    class="wildlife-page-hero wildlife-page-hero-detail solutions-page-hero"
    aria-labelledby="cities-solution-heading"
  >
    <div class="wildlife-page-hero-media solutions-hero-media" aria-hidden="true">
      <img
        src="/images/solutions/solutions-hub-bg.jpg"
        alt=""
        width="1280"
        height="720"
      />
    </div>
    <div class="wildlife-page-hero-shade solutions-hero-shade"></div>
    <div class="wrap wildlife-page-hero-copy">
      <p>
        <a class="maps-back" href={localizePath('/solutions', locale)}>{ui.solutionsPage.back}</a>
        {' · '}
        <a class="maps-back" href={citiesHref}>{ui.solutionsPage.tags.cities}</a>
      </p>
      <div class="eyebrow wildlife-on-dark">{ui.solutionsPage.tags.cities}</div>
      <h1 id="cities-solution-heading">{item.title}</h1>
      <p>{item.hook}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap wildlife-detail">
      <figure class="wildlife-detail-art cities-detail-plate" data-plate={plate}>
        <img src={image} alt={item.imageAlt} width={imageWidth} height={imageHeight} />
        <figcaption>
          <p>{item.caption}</p>
          {
            item.legend && item.legend.length > 0 && (
              <ul class="cities-legend">
                {item.legend.map((label, index) => (
                  <li>
                    <span
                      class="cities-swatch"
                      style={`background:${legendColors[index] ?? '#888'}`}
                      aria-hidden="true"
                    />
                    {label}
                  </li>
                ))}
              </ul>
            )
          }
          {
            item.categories && item.categories.length > 0 && (
              <ol class="cities-categories">
                {item.categories.map((label) => (
                  <li>{label}</li>
                ))}
              </ol>
            )
          }
          {
            photoDoorway ? (
              <p>
                {creditBits().map((bit) =>
                  bit.href ? (
                    <a href={bit.href} rel="noopener noreferrer">{bit.text}</a>
                  ) : (
                    bit.text
                  ),
                )}
              </p>
            ) : (
              <p>
                {item.credit}{' '}
                (
                <a href={item.image.sourceUrl || item.image.licenseUrl} rel="noopener noreferrer">
                  {item.image.license}
                </a>
                )
              </p>
            )
          }
        </figcaption>
      </figure>
      <div class="prose wildlife-prose solutions-prose">
        <div class="meta-row">
          <span class="pill">{ui.solutionsPage.tags.cities}</span>
        </div>
        <h2>{headings.what}</h2>
        {item.what.map((para) => <p>{para}</p>)}
        <h2>{headings.why}</h2>
        {item.why.map((para) => <p>{para}</p>)}
        <h2>{headings.read}</h2>
        {item.read.map((para) => <p>{para}</p>)}
        <h2>{headings.limits}</h2>
        {item.limits.map((para) => <p>{para}</p>)}
        {
          photoDoorway ? (
            <>
              <h2>{ui.solutionsPage.sourcesLabel}</h2>
              <p class="wildlife-sources">{ui.solutionsPage.sourcesVerify}</p>
              <ol class="law-source-list cited-source-list">
                {item.sources.map((source) => (
                  <li>{source.label}: <a href={source.url} rel="noopener noreferrer">{source.url}</a></li>
                ))}
              </ol>
            </>
          ) : (
            <CitedSourceList
              heading={ui.solutionsPage.sourcesLabel}
              note={ui.solutionsPage.sourcesVerify}
              sources={item.sources}
            />
          )
        }
        {
          item.findZone && (
            <p>
              <a href={item.findZone.url} rel="noopener noreferrer">{item.findZone.label}</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cities-legend,
  .cities-categories {
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cities-categories {
    list-style: decimal;
    padding-left: 1.2rem;
  }
  .cities-legend li,
  .cities-categories li {
    margin: 0.2rem 0;
  }
  .cities-swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.4rem;
    border-radius: 2px;
    vertical-align: -0.05rem;
  }
</style>
