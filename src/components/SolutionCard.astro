---
import type { Solution } from '../data/solutions';

interface Props {
  solution: Solution;
  href?: string;
}

const { solution, href = `/solutions#${solution.slug}` } = Astro.props;
const photo = `/images/solutions/${solution.slug}.jpg`;
---

<article class="solution-card-wrap" data-tag={solution.tag} id={solution.slug}>
  <a class="solution-card" href={href}>
    <div class="card-art">
      <img
        src={photo}
        alt={solution.imageAlt}
        width="640"
        height="400"
      />
    </div>
    <div class="card-body">
      <span class="tag">{solution.tag}</span>
      <h3>{solution.fixTitle}</h3>
      <p class="problem-title">{solution.problemTitle}</p>
      <dl class="pf">
        <div>
          <dt>Problem</dt>
          <dd>{solution.problem}</dd>
        </div>
        <div>
          <dt>Fix</dt>
          <dd>{solution.fix}</dd>
        </div>
      </dl>
      <span class="card-cta">Explore solution →</span>
    </div>
  </a>
</article>
