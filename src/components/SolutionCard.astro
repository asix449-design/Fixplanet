---
import type { Solution } from '../data/solutions';
import { solutionPrimarySource } from '../data/solutions';
import { getUi, localizePath, resolveLocale } from '../i18n';

interface Props {
  solution: Solution;
  href?: string;
  hidden?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const {
  solution,
  href = localizePath(`/solutions/${solution.tag}#${solution.slug}`, locale),
  hidden = false,
} = Astro.props;
const photo = `/images/solutions/${solution.slug}.jpg`;
const primary = solutionPrimarySource(solution.sources);
const cardHref = primary?.url ?? href;
const cardRel = primary ? 'noopener noreferrer' : undefined;
---

<article class="solution-card-wrap" data-tag={solution.tag} id={solution.slug} hidden={hidden}>
  <a class="solution-card" href={cardHref} rel={cardRel}>
    <div class="card-art">
      <img
        src={photo}
        alt={solution.imageAlt}
        width="640"
        height="400"
      />
    </div>
    <div class="card-body">
      <span class="tag">{ui.solutionsPage.tags[solution.tag]}</span>
      <h3>{solution.fixTitle}</h3>
      <p class="problem-title">{solution.problemTitle}</p>
      <dl class="pf">
        <div>
          <dt>{ui.solutionsPage.problem}</dt>
          <dd>{solution.problem}</dd>
        </div>
        <div>
          <dt>{ui.solutionsPage.fix}</dt>
          <dd>{solution.fix}</dd>
        </div>
      </dl>
      <span class="card-cta">{ui.solutionsPage.explore}</span>
    </div>
  </a>
  {
    primary && (
      <p class="innovation-card-source">
        <a href={primary.url} rel="noopener noreferrer">
          {ui.solutionsPage.primarySource}: {primary.label}
        </a>
      </p>
    )
  }
</article>
