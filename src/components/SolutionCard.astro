---
import type { Solution } from '../data/solutions';
import { solutionPrimarySource } from '../data/solutions';
import {
  isForestEncyclopediaSlug,
  forestEncyclopediaPath,
} from '../data/solutions-forests';
import {
  isCitiesEncyclopediaSlug,
  citiesEncyclopediaPath,
} from '../data/solutions-cities';
import {
  isWaterEncyclopediaSlug,
  waterEncyclopediaPath,
} from '../data/solutions-water';
import {
  isMaterialsEncyclopediaSlug,
  materialsEncyclopediaPath,
} from '../data/solutions-materials';
import {
  isWasteEncyclopediaSlug,
  wasteEncyclopediaPath,
} from '../data/solutions-waste';
import { getUi, localizePath, resolveLocale } from '../i18n';

interface Props {
  solution: Solution;
  href?: string;
  hidden?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const {
  solution,
  href = localizePath(`/solutions/${solution.tag}#${solution.slug}`, locale),
  hidden = false,
} = Astro.props;
const detailSlug = solution.detailSlug ?? solution.slug;
const photo = `/images/solutions/${solution.slug}.jpg`;
const primary = solutionPrimarySource(solution.sources);
const encyclopediaHref =
  solution.tag === 'water' && isWaterEncyclopediaSlug(detailSlug)
    ? localizePath(waterEncyclopediaPath(detailSlug), locale)
    : solution.tag === 'forests' && isForestEncyclopediaSlug(detailSlug)
      ? localizePath(forestEncyclopediaPath(detailSlug), locale)
      : solution.tag === 'cities' && isCitiesEncyclopediaSlug(detailSlug)
        ? localizePath(citiesEncyclopediaPath(detailSlug), locale)
        : solution.tag === 'waste' && isWasteEncyclopediaSlug(detailSlug)
          ? localizePath(wasteEncyclopediaPath(detailSlug), locale)
          : solution.tag === 'materials' && isMaterialsEncyclopediaSlug(detailSlug)
            ? localizePath(materialsEncyclopediaPath(detailSlug), locale)
            : undefined;
const sourceLabel = solution.sourceLabel ?? primary?.label;
const cardHref = encyclopediaHref ?? primary?.url ?? href;
const cardRel = encyclopediaHref ? undefined : primary ? 'noopener noreferrer' : undefined;
const cta =
  solution.tag === 'forests' && isForestEncyclopediaSlug(detailSlug)
    ? ui.solutionsPage.readPlain
    : encyclopediaHref
      ? ui.solutionsPage.read
      : ui.solutionsPage.explore;
const plate =
  solution.slug === 'low-emission-zones'
    ? 'map'
    : solution.slug === 'congestion-charging' || solution.slug === 'electric-buses'
      ? 'chart'
      : undefined;
---

<article class="solution-card-wrap" data-tag={solution.tag} id={solution.slug} hidden={hidden}>
  <a class="solution-card" href={cardHref} rel={cardRel}>
    <div class:list={['card-art', plate && 'card-art-plate']} data-plate={plate}>
      <img
        src={photo}
        alt={solution.imageAlt}
        width="640"
        height="400"
      />
    </div>
    <div class="card-body">
      <span class="tag">{ui.solutionsPage.tags[solution.tag]}</span>
      <h3>{solution.fixTitle}</h3>
      {solution.problemTitle !== solution.problem && (
        <p class="problem-title">{solution.problemTitle}</p>
      )}
      <dl class="pf">
        <div>
          <dt>{ui.solutionsPage.problem}</dt>
          <dd>{solution.problem}</dd>
        </div>
        <div>
          <dt>{ui.solutionsPage.fix}</dt>
          <dd>{solution.fix}</dd>
        </div>
      </dl>
      <span class="card-cta">{cta}</span>
    </div>
  </a>
  {
    primary && (
      <p class="innovation-card-source">
        <a href={primary.url} rel="noopener noreferrer">
          {ui.solutionsPage.primarySource}: {sourceLabel}
        </a>
      </p>
    )
  }
</article>
