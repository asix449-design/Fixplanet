---
import type { LawEntry } from '../data/law';
import { lawDetailPath, lawImageSrc } from '../data/law';
import { getLawPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  item: LawEntry;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getLawPage(locale);
const { item } = Astro.props;
const href = localizePath(lawDetailPath(item.slug), locale);
---

<article
  class="wildlife-card-wrap"
  data-law-category={item.category}
  data-law-status={item.status}
  data-slug={item.slug}
>
  <a class:list={['wildlife-card', 'law-card', `law-card-${item.status}`]} href={href}>
    <div class="card-art">
      <img
        src={lawImageSrc(item.image)}
        alt={item.imageAlt}
        width="640"
        height="400"
        loading="lazy"
      />
    </div>
    <div class="card-body">
      <div class="innovation-badges">
        <span class="tag">{item.jurisdiction}</span>
        <span class:list={['tag', `status-${item.status}`]}>
          {page.status[item.status]}
        </span>
      </div>
      <h3>{item.title}</h3>
      <p class="scientific-name">{item.citation}</p>
      <p class="wildlife-hook">{item.hook}</p>
      <span class="card-cta">{page.cardCta}</span>
    </div>
  </a>
</article>
