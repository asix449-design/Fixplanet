---
import { getUi, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale).wildlifePage;

const steps = [
  { n: '1', key: 'africa', label: ui.mapAfrica, loss: ui.mapLossAfrica },
  { n: '2', key: 'out', label: ui.mapOut, loss: '' },
  { n: '3', key: 'australia', label: ui.mapAustralia, loss: ui.mapLossAustralia },
  { n: '4', key: 'eurasia', label: ui.mapEurasia, loss: ui.mapLossEurasia },
  { n: '5', key: 'americas', label: ui.mapAmericas, loss: `${ui.mapLossNorth} / ${ui.mapLossSouth}` },
  { n: '6', key: 'islands', label: ui.mapIslands, loss: '' },
] as const;
---

<section class="dispersal" aria-labelledby="dispersal-heading">
  <div class="eyebrow">{ui.heroEyebrow}</div>
  <h2 id="dispersal-heading">{ui.mapTitle}</h2>
  <p class="dispersal-lead">{ui.mapLead}</p>

  <div class="dispersal-frame">
    <svg
      class="dispersal-svg"
      viewBox="0 0 1100 520"
      role="img"
      aria-label={ui.mapAria}
    >
      <title>{ui.mapTitle}</title>
      <desc>{ui.mapLead} {ui.mapSources}</desc>
      <rect width="1100" height="520" fill="#e6eee4" rx="14"></rect>

      <!-- North America -->
      <path
        fill="#1b7a4e"
        d="M70 70c40-28 110-40 170-28 48 10 78 38 92 72 10 24 8 52-6 78-18 32-58 48-96 58-28 8-62 6-86-10-22-14-40-40-46-68-8-34 4-74 0-102z"
      ></path>
      <!-- Central / Caribbean hint -->
      <ellipse cx="218" cy="236" rx="22" ry="10" fill="#3fa36a"></ellipse>
      <!-- South America -->
      <path
        fill="#1b7a4e"
        d="M188 268c28-8 58 2 72 28 12 22 18 52 10 86-8 36-32 68-58 82-18 10-40 4-50-14-12-22-8-56-2-84 6-28 10-86 28-98z"
      ></path>
      <!-- Europe -->
      <path
        fill="#1b7a4e"
        d="M470 78c28-16 64-12 86 8 16 16 18 40 8 58-14 24-46 30-72 24-22-6-38-24-40-46-2-16 6-34 18-44z"
      ></path>
      <!-- Africa -->
      <path
        fill="#14603c"
        d="M478 168c36-10 72 4 88 34 14 26 18 62 8 96-10 36-40 70-74 78-28 6-54-10-64-36-12-28-4-66 6-96 10-28 16-70 36-76z"
      ></path>
      <!-- Asia -->
      <path
        fill="#1b7a4e"
        d="M560 70c70-24 160-20 230 10 48 20 86 58 96 108 8 38-8 78-40 98-36 22-86 16-128 4-40-12-86-10-118-34-28-20-36-56-28-88 8-34 24-78 0-98z"
      ></path>
      <!-- Australia / Sahul -->
      <path
        fill="#1b7a4e"
        d="M820 318c40-16 86-8 108 22 16 22 14 54-4 74-20 22-56 28-86 18-28-10-48-34-50-60-2-22 8-44 32-54z"
      ></path>
      <!-- Madagascar -->
      <ellipse cx="592" cy="368" rx="12" ry="20" fill="#3fa36a"></ellipse>
      <!-- New Zealand -->
      <ellipse cx="1008" cy="408" rx="8" ry="16" fill="#3fa36a"></ellipse>
      <ellipse cx="1022" cy="428" rx="7" ry="12" fill="#3fa36a"></ellipse>

      <!-- Routes: not the only meaning — steps are also listed -->
      <g fill="none" stroke="#3fa36a" stroke-width="3" stroke-linecap="round" opacity="0.85">
        <path d="M520 250 C 545 210, 555 190, 575 175" marker-end="url(#arrow)"></path>
        <path d="M575 175 C 680 210, 780 280, 860 340"></path>
        <path d="M575 175 C 540 140, 520 120, 510 108"></path>
        <path d="M700 120 C 560 60, 280 40, 168 118"></path>
        <path d="M592 368 C 700 400, 880 420, 1008 408" stroke-dasharray="6 7"></path>
      </g>
      <defs>
        <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill="#3fa36a"></path>
        </marker>
      </defs>

      <!-- Numbered markers: shape + number, not color alone -->
      <g font-family="Inter, ui-sans-serif, sans-serif" font-size="15" font-weight="700">
        <g transform="translate(500 248)">
          <circle r="16" fill="#f4f7f2" stroke="#14221a" stroke-width="2"></circle>
          <text x="0" y="5" text-anchor="middle" fill="#14221a">1</text>
        </g>
        <g transform="translate(578 172)">
          <circle r="16" fill="#f4f7f2" stroke="#14221a" stroke-width="2"></circle>
          <text x="0" y="5" text-anchor="middle" fill="#14221a">2</text>
        </g>
        <g transform="translate(868 342)">
          <circle r="16" fill="#f4f7f2" stroke="#14221a" stroke-width="2"></circle>
          <text x="0" y="5" text-anchor="middle" fill="#14221a">3</text>
        </g>
        <g transform="translate(508 104)">
          <circle r="16" fill="#f4f7f2" stroke="#14221a" stroke-width="2"></circle>
          <text x="0" y="5" text-anchor="middle" fill="#14221a">4</text>
        </g>
        <g transform="translate(160 118)">
          <circle r="16" fill="#f4f7f2" stroke="#14221a" stroke-width="2"></circle>
          <text x="0" y="5" text-anchor="middle" fill="#14221a">5</text>
        </g>
        <g transform="translate(1008 408)">
          <circle r="16" fill="#f4f7f2" stroke="#14221a" stroke-width="2"></circle>
          <text x="0" y="5" text-anchor="middle" fill="#14221a">6</text>
        </g>
      </g>
    </svg>

    <ol class="dispersal-steps">
      {
        steps.map((step) => (
          <li>
            <span class="dispersal-n" aria-hidden="true">
              {step.n}
            </span>
            <span>
              <strong>{step.label}</strong>
              {step.loss ? <span class="dispersal-loss">{step.loss}</span> : null}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <p class="dispersal-sources">{ui.mapSources}</p>
</section>
