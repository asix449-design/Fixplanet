---
interface Props {
  label: string;
  credit?: string;
}

const { label, credit } = Astro.props;
---

<div class="earth-globe" data-earth-globe role="img" aria-label={label}>
  <div class="earth-globe-stage">
    <img
      class="earth-globe-fallback"
      src="/images/home/earth-globe-still.png"
      width="900"
      height="900"
      alt=""
    />
    <canvas class="earth-globe-canvas" hidden aria-hidden="true"></canvas>
  </div>
  {credit ? <p class="earth-globe-credit">{credit}</p> : null}
</div>

<script>
  import * as THREE from 'three';

  const DAY_TEXTURE = '/images/home/earth-day.jpg';
  const root = document.querySelector<HTMLElement>('[data-earth-globe]');
  const stage = root?.querySelector<HTMLElement>('.earth-globe-stage');
  const canvas = root?.querySelector<HTMLCanvasElement>('.earth-globe-canvas');
  const fallback = root?.querySelector<HTMLImageElement>('.earth-globe-fallback');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const webglOk = (() => {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    } catch {
      return false;
    }
  })();

  if (root && stage && canvas && fallback && !reduceMotion && webglOk) {
    void startGlobe(stage, canvas, fallback).catch(() => {
      /* keep the still fallback */
    });
  }

  function loadTexture(url: string): Promise<THREE.Texture> {
    const loader = new THREE.TextureLoader();
    return new Promise((resolve, reject) => {
      loader.load(
        url,
        (tex) => resolve(tex),
        undefined,
        () => reject(new Error(url)),
      );
    });
  }

  /** Soft ocean shine from the day map — blue water, dull land. No extra asset. */
  function oceanSpecularFromDay(day: THREE.Texture): THREE.CanvasTexture | null {
    const image = day.image as CanvasImageSource | undefined;
    const width = (image as HTMLImageElement | undefined)?.naturalWidth || (image as HTMLCanvasElement | undefined)?.width;
    const height = (image as HTMLImageElement | undefined)?.naturalHeight || (image as HTMLCanvasElement | undefined)?.height;
    if (!image || !width || !height) return null;

    const work = document.createElement('canvas');
    work.width = width;
    work.height = height;
    const ctx = work.getContext('2d');
    if (!ctx) return null;
    ctx.drawImage(image, 0, 0, width, height);
    const pixels = ctx.getImageData(0, 0, width, height);
    const data = pixels.data;
    for (let i = 0; i < data.length; i += 4) {
      const r = data[i];
      const g = data[i + 1];
      const b = data[i + 2];
      const ocean = b > r + 12 && b > g + 4 && b > 70;
      const spec = ocean ? 210 : 18;
      data[i] = spec;
      data[i + 1] = spec;
      data[i + 2] = spec;
    }
    ctx.putImageData(pixels, 0, 0);
    const spec = new THREE.CanvasTexture(work);
    spec.colorSpace = THREE.NoColorSpace;
    spec.wrapS = THREE.ClampToEdgeWrapping;
    spec.wrapT = THREE.ClampToEdgeWrapping;
    return spec;
  }

  async function startGlobe(
    host: HTMLElement,
    canvasEl: HTMLCanvasElement,
    still: HTMLImageElement,
  ) {
    const renderer = new THREE.WebGLRenderer({
      canvas: canvasEl,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 20);
    camera.position.set(0, 0.08, 2.55);

    const day = await loadTexture(DAY_TEXTURE);
    day.colorSpace = THREE.SRGBColorSpace;
    day.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy());
    day.wrapS = THREE.ClampToEdgeWrapping;
    day.wrapT = THREE.ClampToEdgeWrapping;

    const specularMap = oceanSpecularFromDay(day);
    const globeMat = new THREE.MeshPhongMaterial({
      map: day,
      specularMap: specularMap ?? undefined,
      specular: new THREE.Color(0x6aa4c8),
      shininess: 18,
      emissive: new THREE.Color(0xffffff),
      emissiveMap: day,
      emissiveIntensity: 0.28,
      flatShading: false,
    });

    const earth = new THREE.Group();
    earth.add(new THREE.Mesh(new THREE.SphereGeometry(1, 64, 64), globeMat));

    const atmosphere = new THREE.Mesh(
      new THREE.SphereGeometry(1.035, 64, 64),
      new THREE.MeshBasicMaterial({
        color: 0x6eb6ff,
        transparent: true,
        opacity: 0.13,
        side: THREE.BackSide,
        depthWrite: false,
      }),
    );
    earth.add(atmosphere);

    const rim = new THREE.Mesh(
      new THREE.SphereGeometry(1.055, 48, 48),
      new THREE.MeshBasicMaterial({
        color: 0x9ad4ff,
        transparent: true,
        opacity: 0.07,
        side: THREE.BackSide,
        depthWrite: false,
      }),
    );
    earth.add(rim);

    earth.rotation.y = 0.22;
    earth.rotation.x = 0.16;
    scene.add(earth);

    scene.add(new THREE.AmbientLight(0xd8e2ee, 0.82));
    scene.add(new THREE.HemisphereLight(0xc5d8ee, 0x1a2430, 0.38));
    const sun = new THREE.DirectionalLight(0xfff6e8, 1.35);
    sun.position.set(-0.55, 0.28, 2.15);
    scene.add(sun);

    let width = 0;
    const fit = () => {
      const next = host.clientWidth || 320;
      if (next === width) return;
      width = next;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
      renderer.setSize(width, width, false);
      camera.aspect = 1;
      camera.updateProjectionMatrix();
    };
    fit();

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let velY = 0;
    let visible = true;
    let running = true;

    const onPointerDown = (event: PointerEvent) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      canvasEl.setPointerCapture(event.pointerId);
      canvasEl.style.cursor = 'grabbing';
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!dragging) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      earth.rotation.y += dx * 0.0055;
      earth.rotation.x = Math.max(-0.7, Math.min(0.7, earth.rotation.x + dy * 0.004));
      velY = dx * 0.0055;
    };
    const onPointerUp = (event: PointerEvent) => {
      dragging = false;
      canvasEl.style.cursor = 'grab';
      try {
        canvasEl.releasePointerCapture(event.pointerId);
      } catch {
        /* already released */
      }
    };

    canvasEl.addEventListener('pointerdown', onPointerDown);
    canvasEl.addEventListener('pointermove', onPointerMove);
    canvasEl.addEventListener('pointerup', onPointerUp);
    canvasEl.addEventListener('pointercancel', onPointerUp);
    canvasEl.addEventListener('lostpointercapture', () => {
      dragging = false;
      canvasEl.style.cursor = 'grab';
    });

    const resize = new ResizeObserver(fit);
    resize.observe(host);
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
      },
      { threshold: 0.08 },
    );
    io.observe(host);
    document.addEventListener('visibilitychange', () => {
      running = document.visibilityState !== 'hidden';
    });

    still.hidden = true;
    canvasEl.hidden = false;
    canvasEl.style.cursor = 'grab';

    const tick = () => {
      if (running && visible) {
        if (!dragging) {
          earth.rotation.y += 0.0014 + velY;
          velY *= 0.94;
        }
        renderer.render(scene, camera);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
