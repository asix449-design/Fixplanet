---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="earth-globe" data-earth-globe role="img" aria-label={label}>
  <div class="earth-globe-stage">
    <img
      class="earth-globe-fallback"
      src="/images/home/earth-globe-still.jpg"
      width="900"
      height="900"
      alt=""
    />
    <canvas class="earth-globe-canvas" hidden aria-hidden="true"></canvas>
  </div>
</div>

<script>
  import * as THREE from 'three';

  const root = document.querySelector<HTMLElement>('[data-earth-globe]');
  const stage = root?.querySelector<HTMLElement>('.earth-globe-stage');
  const canvas = root?.querySelector<HTMLCanvasElement>('.earth-globe-canvas');
  const fallback = root?.querySelector<HTMLImageElement>('.earth-globe-fallback');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const webglOk = (() => {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    } catch {
      return false;
    }
  })();

  if (root && stage && canvas && fallback && !reduceMotion && webglOk) {
    void startGlobe(stage, canvas, fallback);
  }

  async function startGlobe(
    host: HTMLElement,
    canvasEl: HTMLCanvasElement,
    still: HTMLImageElement,
  ) {
    const renderer = new THREE.WebGLRenderer({
      canvas: canvasEl,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 20);
    camera.position.set(0, 0.12, 2.55);

    const loader = new THREE.TextureLoader();
    const [colorMap, glowMap] = await Promise.all([
      loader.loadAsync('/images/home/earth-dark.jpg'),
      loader.loadAsync('/images/home/earth-emissive.jpg'),
    ]);
    colorMap.colorSpace = THREE.SRGBColorSpace;
    glowMap.colorSpace = THREE.SRGBColorSpace;
    colorMap.anisotropy = renderer.capabilities.getMaxAnisotropy();

    const earth = new THREE.Mesh(
      new THREE.SphereGeometry(1, 64, 64),
      new THREE.MeshStandardMaterial({
        map: colorMap,
        emissiveMap: glowMap,
        emissive: new THREE.Color(0xff4a12),
        emissiveIntensity: 1.15,
        roughness: 0.92,
        metalness: 0.04,
      }),
    );
    earth.rotation.y = 0.35;
    earth.rotation.x = 0.18;
    scene.add(earth);

    const atmosphere = new THREE.Mesh(
      new THREE.SphereGeometry(1.045, 48, 48),
      new THREE.MeshBasicMaterial({
        color: 0xff4a12,
        transparent: true,
        opacity: 0.09,
        side: THREE.BackSide,
        depthWrite: false,
      }),
    );
    scene.add(atmosphere);

    scene.add(new THREE.AmbientLight(0x3d3d36, 0.7));
    const key = new THREE.DirectionalLight(0xffd2b0, 1.05);
    key.position.set(2.6, 1.1, 2.2);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xc0ff00, 0.18);
    rim.position.set(-2.2, -0.4, 1.4);
    scene.add(rim);

    let width = 0;
    let height = 0;
    const fit = () => {
      const next = host.clientWidth || 320;
      if (next === width) return;
      width = next;
      height = next;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
      renderer.setSize(width, height, false);
      camera.aspect = 1;
      camera.updateProjectionMatrix();
    };
    fit();

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let velY = 0;
    let visible = true;
    let running = true;

    const onPointerDown = (event: PointerEvent) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      canvasEl.setPointerCapture(event.pointerId);
      canvasEl.style.cursor = 'grabbing';
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!dragging) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      earth.rotation.y += dx * 0.0055;
      earth.rotation.x = Math.max(-0.7, Math.min(0.7, earth.rotation.x + dy * 0.004));
      velY = dx * 0.0055;
    };
    const onPointerUp = (event: PointerEvent) => {
      dragging = false;
      canvasEl.style.cursor = 'grab';
      try {
        canvasEl.releasePointerCapture(event.pointerId);
      } catch {
        /* already released */
      }
    };

    canvasEl.addEventListener('pointerdown', onPointerDown);
    canvasEl.addEventListener('pointermove', onPointerMove);
    canvasEl.addEventListener('pointerup', onPointerUp);
    canvasEl.addEventListener('pointercancel', onPointerUp);
    canvasEl.addEventListener('lostpointercapture', () => {
      dragging = false;
      canvasEl.style.cursor = 'grab';
    });

    const resize = new ResizeObserver(fit);
    resize.observe(host);

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
      },
      { threshold: 0.08 },
    );
    io.observe(host);

    const onVisibility = () => {
      running = document.visibilityState !== 'hidden';
    };
    document.addEventListener('visibilitychange', onVisibility);

    still.hidden = true;
    canvasEl.hidden = false;
    canvasEl.style.cursor = 'grab';

    const tick = () => {
      if (!running) {
        requestAnimationFrame(tick);
        return;
      }
      if (visible) {
        if (!dragging) {
          earth.rotation.y += 0.0016 + velY;
          velY *= 0.94;
        }
        atmosphere.rotation.copy(earth.rotation);
        renderer.render(scene, camera);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
