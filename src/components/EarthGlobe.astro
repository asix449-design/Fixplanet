---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="earth-globe" data-earth-globe role="img" aria-label={label}>
  <div class="earth-globe-stage">
    <img
      class="earth-globe-fallback"
      src="/images/home/earth-globe-still.png"
      width="900"
      height="900"
      alt=""
    />
    <canvas class="earth-globe-canvas" hidden aria-hidden="true"></canvas>
  </div>
</div>

<script>
  import * as THREE from 'three';

  const LIME = 0xc0ff00;
  const root = document.querySelector<HTMLElement>('[data-earth-globe]');
  const stage = root?.querySelector<HTMLElement>('.earth-globe-stage');
  const canvas = root?.querySelector<HTMLCanvasElement>('.earth-globe-canvas');
  const fallback = root?.querySelector<HTMLImageElement>('.earth-globe-fallback');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const webglOk = (() => {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    } catch {
      return false;
    }
  })();

  if (root && stage && canvas && fallback && !reduceMotion && webglOk) {
    void startGlobe(stage, canvas, fallback).catch(() => {
      /* keep the lime-on-black still */
    });
  }

  async function startGlobe(
    host: HTMLElement,
    canvasEl: HTMLCanvasElement,
    still: HTMLImageElement,
  ) {
    const renderer = new THREE.WebGLRenderer({
      canvas: canvasEl,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 20);
    camera.position.set(0, 0.08, 2.55);

    const earth = new THREE.Group();
    earth.add(
      new THREE.Mesh(
        new THREE.SphereGeometry(1, 64, 64),
        new THREE.MeshBasicMaterial({ color: 0x050505 }),
      ),
    );

    const buffer = await fetch('/data/earth-countries.bin').then((res) => {
      if (!res.ok) throw new Error('earth-countries.bin');
      return res.arrayBuffer();
    });
    const positions = new Float32Array(buffer);
    const lines = new THREE.BufferGeometry();
    lines.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    earth.add(
      new THREE.LineSegments(
        lines,
        new THREE.LineBasicMaterial({
          color: LIME,
          transparent: true,
          opacity: 0.92,
        }),
      ),
    );
    earth.rotation.y = 0.22;
    earth.rotation.x = 0.16;
    scene.add(earth);

    const rimPts = Array.from({ length: 160 }, (_, i) => {
      const t = (i / 160) * Math.PI * 2;
      return new THREE.Vector3(Math.cos(t), Math.sin(t), 0);
    });
    const rim = new THREE.LineLoop(
      new THREE.BufferGeometry().setFromPoints(rimPts),
      new THREE.LineBasicMaterial({ color: LIME }),
    );
    rim.scale.setScalar(1.001);
    scene.add(rim);

    let width = 0;
    const fit = () => {
      const next = host.clientWidth || 320;
      if (next === width) return;
      width = next;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
      renderer.setSize(width, width, false);
      camera.aspect = 1;
      camera.updateProjectionMatrix();
    };
    fit();

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let velY = 0;
    let visible = true;
    let running = true;

    const onPointerDown = (event: PointerEvent) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      canvasEl.setPointerCapture(event.pointerId);
      canvasEl.style.cursor = 'grabbing';
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!dragging) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      earth.rotation.y += dx * 0.0055;
      earth.rotation.x = Math.max(-0.7, Math.min(0.7, earth.rotation.x + dy * 0.004));
      velY = dx * 0.0055;
    };
    const onPointerUp = (event: PointerEvent) => {
      dragging = false;
      canvasEl.style.cursor = 'grab';
      try {
        canvasEl.releasePointerCapture(event.pointerId);
      } catch {
        /* already released */
      }
    };

    canvasEl.addEventListener('pointerdown', onPointerDown);
    canvasEl.addEventListener('pointermove', onPointerMove);
    canvasEl.addEventListener('pointerup', onPointerUp);
    canvasEl.addEventListener('pointercancel', onPointerUp);
    canvasEl.addEventListener('lostpointercapture', () => {
      dragging = false;
      canvasEl.style.cursor = 'grab';
    });

    const resize = new ResizeObserver(fit);
    resize.observe(host);
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
      },
      { threshold: 0.08 },
    );
    io.observe(host);
    document.addEventListener('visibilitychange', () => {
      running = document.visibilityState !== 'hidden';
    });

    still.hidden = true;
    canvasEl.hidden = false;
    canvasEl.style.cursor = 'grab';

    const tick = () => {
      if (running && visible) {
        if (!dragging) {
          earth.rotation.y += 0.0014 + velY;
          velY *= 0.94;
        }
        rim.quaternion.copy(camera.quaternion);
        renderer.render(scene, camera);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
