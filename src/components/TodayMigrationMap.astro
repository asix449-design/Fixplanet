---
import fs from 'node:fs';
import path from 'node:path';
import CitedSourceList from './CitedSourceList.astro';
import {
  corridorsForRegion,
  formatSignedCount,
  formatStockCount,
  todayDataset,
  todayRegionAnchors,
  todayRegionIds,
  todaySources,
  todayTabletLayout,
  type TodayRegionId,
} from '../data/migration-today';
import { getMigrationPage, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const page = getMigrationPage(locale);
const ui = page.today;
const numberLocale = locale === 'en' ? 'en-GB' : locale;

const svgPath = path.join(process.cwd(), 'public/images/maps/world-countries.svg');
let mapSvg = fs.readFileSync(svgPath, 'utf8');
mapSvg = mapSvg
  .replace(/<\?xml[^>]*>/, '')
  .replace(
    '<svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="2754" height="1398">',
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2754 1398" role="img" aria-hidden="true" focusable="false">',
  )
  .replace(/fill: #c0c0c0/g, 'fill: #050505')
  .replace(/stroke: #ffffff/g, 'stroke: #c0ff00')
  .replace(/fill: #ffffff/g, 'fill: #000000')
  .replace(/stroke: #000000/g, 'stroke: #c0ff00')
  .replace(/stroke-width: 0\.5/g, 'stroke-width: 1.15')
  .replace(/stroke-width: 0\.2/g, 'stroke-width: 0.85')
  .replace(
    '.antxx\n{\n\topacity: 1;\n\tfill: #050505;\n}',
    '.antxx\n{\n\topacity: 0.35;\n\tfill: #050505;\n\tstroke: #3d4a12;\n}',
  );

const tablets = todayRegionIds.map((id) => {
  const net = todayDataset.netMigration.regions[id];
  const abs = Math.abs(net);
  const figure = formatSignedCount(net, numberLocale);
  const unit = abs >= 1_000_000 ? ui.netUnitMillion : ui.netUnitPeople;
  return {
    id,
    net,
    figure,
    unit,
    name: ui.regions[id].shortName,
    layout: todayTabletLayout[id],
  };
});

const panelPayload = Object.fromEntries(
  todayRegionIds.map((id) => {
    const stock = todayDataset.migrantStock.regions[id];
    const net = todayDataset.netMigration.regions[id];
    return [
      id,
      {
        name: ui.regions[id].name,
        caption: ui.regions[id].caption,
        originsIntro: ui.regions[id].originsIntro,
        corridorsIntro: ui.regions[id].corridorsIntro,
        net,
        netFigure: formatSignedCount(net, numberLocale),
        netUnit: Math.abs(net) >= 1_000_000 ? ui.netUnitMillion : ui.netUnitPeople,
        stock: stock.destination,
        stockFigure: formatStockCount(stock.destination, numberLocale),
        origins: stock.origins.map((row) => ({
          id: row.id,
          label: ui.originNames[row.id as TodayRegionId] ?? row.id,
          value: row.value,
          figure: formatStockCount(row.value, numberLocale),
          approx: row.approx,
        })),
        corridors: corridorsForRegion(id).map((row) => ({
          id: row.id,
          from: row.from,
          to: row.to,
          fromRegion: row.fromRegion,
          toRegion: row.toRegion,
          kind: row.kind,
          stock: row.stock,
          figure: row.stock == null ? '' : formatStockCount(row.stock, numberLocale),
          approx: row.approx,
          note: row.note,
        })),
      },
    ];
  }),
);

const interArrows = todayDataset.corridors
  .filter((row) => row.kind === 'inter-regional' && row.fromRegion !== row.toRegion)
  .map((row) => {
    const a = todayRegionAnchors[row.fromRegion];
    const b = todayRegionAnchors[row.toRegion];
    return {
      id: row.id,
      from: row.fromRegion,
      to: row.toRegion,
      x1: a.x,
      y1: a.y,
      x2: b.x,
      y2: b.y,
    };
  });
---

<section class="today-mig" aria-labelledby="today-map-heading" data-today-mig>
  <h2 id="today-map-heading">{ui.mapTitle}</h2>
  <p class="dispersal-lead">{ui.lead}</p>
  <p class="oceans-source-note">{ui.honesty}</p>

  <div class="today-mig-layout">
    <div class="today-mig-stage">
      <div class="today-mig-map" role="img" aria-label={ui.mapAria}>
        <div class="today-mig-svg" set:html={mapSvg}></div>
        <svg class="today-mig-arrows" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <marker id="today-arrow-head" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
              <path d="M0 0 L5 2.5 L0 5 Z" fill="#c0ff00"></path>
            </marker>
          </defs>
          {
            interArrows.map((arrow) => (
              <line
                data-today-arrow={`${arrow.from} ${arrow.to}`}
                x1={arrow.x1}
                y1={arrow.y1}
                x2={arrow.x2}
                y2={arrow.y2}
                marker-end="url(#today-arrow-head)"
              ></line>
            ))
          }
        </svg>
        <p class="today-mig-arrow-legend" data-today-arrow-legend hidden>{ui.arrowLegend}</p>
        <div class="today-mig-tablets">
          {
            tablets.map((tablet) => (
              <button
                type="button"
                class:list={['today-mig-tablet', tablet.net < 0 && 'is-loss']}
                style={`left:${tablet.layout.left}%;top:${tablet.layout.top}%`}
                data-today-region={tablet.id}
                aria-expanded="false"
                aria-controls="today-mig-panel"
              >
                <span class="today-mig-tablet-name">{tablet.name}</span>
                <strong class="today-mig-tablet-figure">{tablet.figure}</strong>
                <span class="today-mig-tablet-unit">{tablet.unit}</span>
                <span class="today-mig-tablet-source">{ui.netLabel}</span>
                <span class="visually-hidden">
                  {ui.openTablet} {ui.regions[tablet.id].name}
                </span>
              </button>
            ))
          }
        </div>
      </div>
      <p class="dispersal-sources dispersal-base-credit">{ui.mapCredit}</p>
    </div>

    <aside class="today-mig-panel wildlife-copy-card" id="today-mig-panel" data-today-panel>
      <p class="today-mig-empty" data-today-empty>{ui.emptyPanel}</p>
      <div class="today-mig-detail" data-today-detail hidden>
        <div class="today-mig-panel-top">
          <h3 data-today-name></h3>
          <button type="button" class="today-mig-close" data-today-close>
            {ui.close}
          </button>
        </div>
        <p class="today-mig-caption" data-today-caption></p>
        <dl class="today-mig-stats">
          <div>
            <dt>{ui.netLabel}</dt>
            <dd>
              <strong data-today-net></strong>
              <span data-today-net-unit></span>
            </dd>
          </div>
          <div>
            <dt>{ui.stockLabel}</dt>
            <dd>
              <strong data-today-stock></strong>
              <span> {ui.million}</span>
              <em class="today-mig-stock-tag">{ui.stockNotFlow}</em>
            </dd>
          </div>
        </dl>
        <h4>{ui.originsTitle}</h4>
        <p class="today-mig-intro" data-today-origins-intro></p>
        <ul class="today-mig-origins" data-today-origins></ul>
        <p class="wildlife-sources">{ui.originsHint}</p>
        <h4>{ui.corridorsTitle}</h4>
        <p class="today-mig-intro" data-today-corridors-intro></p>
        <ul class="today-mig-corridors" data-today-corridors></ul>
        <p class="wildlife-sources">{ui.corridorsNote}</p>
      </div>
    </aside>
  </div>

  <p class="oceans-source-note today-mig-intra">{ui.intraCaption}</p>
  <CitedSourceList heading={page.sourcesLabel} sources={todaySources} />
</section>

<script
  define:vars={{
    panelPayload,
    million: ui.million,
    approx: ui.approx,
  }}
>
  const root = document.querySelector('[data-today-mig]');
  if (root) {
    const buttons = root.querySelectorAll('[data-today-region]');
    const empty = root.querySelector('[data-today-empty]');
    const detail = root.querySelector('[data-today-detail]');
    const nameEl = root.querySelector('[data-today-name]');
    const captionEl = root.querySelector('[data-today-caption]');
    const netEl = root.querySelector('[data-today-net]');
    const netUnitEl = root.querySelector('[data-today-net-unit]');
    const stockEl = root.querySelector('[data-today-stock]');
    const originsIntro = root.querySelector('[data-today-origins-intro]');
    const corridorsIntro = root.querySelector('[data-today-corridors-intro]');
    const originsList = root.querySelector('[data-today-origins]');
    const corridorsList = root.querySelector('[data-today-corridors]');
    const arrows = root.querySelectorAll('[data-today-arrow]');
    const arrowLegend = root.querySelector('[data-today-arrow-legend]');
    const closeBtn = root.querySelector('[data-today-close]');

    function close() {
      buttons.forEach((button) => {
        button.classList.remove('is-open');
        button.setAttribute('aria-expanded', 'false');
      });
      if (empty) empty.hidden = false;
      if (detail) detail.hidden = true;
      arrows.forEach((line) => line.classList.remove('is-on'));
      if (arrowLegend) arrowLegend.hidden = true;
    }

    function open(id) {
      const data = panelPayload[id];
      if (!data) return;
      buttons.forEach((button) => {
        const on = button.getAttribute('data-today-region') === id;
        button.classList.toggle('is-open', on);
        button.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      if (empty) empty.hidden = true;
      if (detail) detail.hidden = false;
      if (nameEl) nameEl.textContent = data.name;
      if (captionEl) captionEl.textContent = data.caption;
      if (netEl) netEl.textContent = data.netFigure;
      if (netUnitEl) netUnitEl.textContent = ' ' + data.netUnit;
      if (stockEl) stockEl.textContent = data.stockFigure;
      if (originsIntro) originsIntro.textContent = data.originsIntro;
      if (corridorsIntro) corridorsIntro.textContent = data.corridorsIntro;
      if (originsList) {
        originsList.innerHTML = data.origins
          .map((row) => {
            const prefix = row.approx ? approx + ' ' : '';
            return (
              '<li><span>' +
              row.label +
              '</span><strong>' +
              prefix +
              row.figure +
              ' ' +
              million +
              '</strong></li>'
            );
          })
          .join('');
      }
      if (corridorsList) {
        corridorsList.innerHTML = data.corridors
          .map((row) => {
            const vol =
              row.figure === ''
                ? ''
                : '<strong>' + (row.approx ? approx + ' ' : '') + row.figure + ' ' + million + '</strong>';
            return (
              '<li><span>' +
              row.from +
              ' → ' +
              row.to +
              '</span>' +
              vol +
              '<em>' +
              row.note +
              '</em></li>'
            );
          })
          .join('');
      }
      arrows.forEach((line) => {
        const pair = (line.getAttribute('data-today-arrow') || '').split(' ');
        const on = pair.includes(id);
        line.classList.toggle('is-on', on);
      });
      if (arrowLegend) arrowLegend.hidden = false;
      detail?.scrollIntoView({ block: 'nearest' });
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-today-region');
        if (button.classList.contains('is-open')) close();
        else open(id);
      });
    });
    closeBtn?.addEventListener('click', close);
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
