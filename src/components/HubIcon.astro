---
import type { HubIconName } from '../data/hub';

export type { HubIconName };

interface Props {
  name: HubIconName;
}

const { name } = Astro.props;
---

{
  name === 'leaf' && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M5 14.5C5 9.8 9.2 5.2 17 4c.4 4.8-.8 8.8-3.6 11.2 1.8-.6 3.6-2 4.6-4.2.8 2.6.4 5.4-1.4 7.5C15 20.4 12.8 21 11 21c-3.4 0-6-2.7-6-6.5z"></path>
    </svg>
  )
}
{
  name === 'circuit' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="6.2" cy="6.2" r="1.6"></circle>
      <circle cx="17.8" cy="6.2" r="1.6"></circle>
      <circle cx="6.2" cy="17.8" r="1.6"></circle>
      <circle cx="17.8" cy="17.8" r="1.6"></circle>
      <path d="M7.8 6.2h8.4M6.2 7.8v8.4M17.8 7.8v8.4M7.8 17.8h8.4"></path>
      <circle cx="12" cy="12" r="2.1"></circle>
    </svg>
  )
}
{
  name === 'globe' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="8.2"></circle>
      <path d="M3.8 12h16.4M12 3.8c2.8 2.8 2.8 13.6 0 16.4M12 3.8c-2.8 2.8-2.8 13.6 0 16.4"></path>
    </svg>
  )
}
{
  name === 'scales' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M12 4v15M8 20h8M12 6.5 6 13h12L12 6.5z"></path>
      <path d="M6 13c0 1.8 1.2 2.8 2.8 2.8S11.6 14.8 11.6 13M12.4 13c0 1.8 1.2 2.8 2.8 2.8S18 14.8 18 13"></path>
    </svg>
  )
}
{
  name === 'paw' && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="7.2" cy="8.2" r="1.8"></circle>
      <circle cx="12" cy="6.4" r="1.8"></circle>
      <circle cx="16.8" cy="8.2" r="1.8"></circle>
      <ellipse cx="12" cy="15.4" rx="4.1" ry="3.3"></ellipse>
    </svg>
  )
}
{
  name === 'trees' && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3 6.2 11h3.1L5 17h5v4h4v-4h5l-4.3-6h3.1L12 3z"></path>
    </svg>
  )
}
{
  name === 'book' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 4.5h10.5A3.5 3.5 0 0 1 19 8v12.5H8.5A3.5 3.5 0 0 0 5 17V4.5z"></path>
      <path d="M5 17a3.5 3.5 0 0 1 3.5-3.5H19"></path>
    </svg>
  )
}
{
  name === 'compass' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="8.2"></circle>
      <path d="m14.7 9.3-1.2 4.2-4.2 1.2 1.2-4.2 4.2-1.2z"></path>
    </svg>
  )
}
{
  name === 'bolt' && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.1 2.6 5.4 13.2h6.1l-1.2 8.2 7.8-11.2h-6.1l1.1-7.6z"></path>
    </svg>
  )
}
{
  name === 'droplet' && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 3.2s6.8 7.4 6.8 12.1A6.8 6.8 0 1 1 5.2 15.3C5.2 10.6 12 3.2 12 3.2z"></path>
    </svg>
  )
}
{
  name === 'recycle' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="m8 6.5 2.2-3.2h3.6L16 6.5"></path>
      <path d="M7.6 6.5H4.8m11.6 0h2.6"></path>
      <path d="m16.2 17.2 3.1-2.1-1.4-3.6"></path>
      <path d="m18.8 15.4 1.8 2.1M15.4 12l-2.4-1.2"></path>
      <path d="m7.6 17.4-1.8-3.6L8.8 11"></path>
      <path d="m6.2 14.2-2 .4M8.4 11.4l2.5.2"></path>
    </svg>
  )
}
{
  name === 'city' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M4 20V9.5L8 7v13M8 20V7l6 3.2V20M14 20V10.2L20 8v12M4 20h16"></path>
    </svg>
  )
}
{
  name === 'hex' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M12 3.4 19 7.4v9.2L12 20.6 5 16.6V7.4L12 3.4z"></path>
    </svg>
  )
}
{
  name === 'wave' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M3 13.2c2 0 2-2.2 4-2.2s2 2.2 4 2.2 2-2.2 4-2.2 2 2.2 4 2.2"></path>
      <path d="M3 17.6c2 0 2-2.2 4-2.2s2 2.2 4 2.2 2-2.2 4-2.2 2 2.2 4 2.2"></path>
    </svg>
  )
}
{
  name === 'grid' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="4" y="4" width="6.2" height="6.2" rx="1.1"></rect>
      <rect x="13.8" y="4" width="6.2" height="6.2" rx="1.1"></rect>
      <rect x="4" y="13.8" width="6.2" height="6.2" rx="1.1"></rect>
      <rect x="13.8" y="13.8" width="6.2" height="6.2" rx="1.1"></rect>
    </svg>
  )
}
{
  name === 'alert' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M12 4.2 21 19.4H3L12 4.2z"></path>
      <path d="M12 10.2v4.2M12 16.8v.6"></path>
    </svg>
  )
}
{
  name === 'terrain' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M3 18.5 8.2 9.6l3.1 5.2 2.6-3.8L21 18.5H3z"></path>
      <path d="M3 18.5h18"></path>
      <path d="M14.2 10.8c1.1-1.6 2.4-2.6 4.3-3.1"></path>
    </svg>
  )
}
{
  name === 'gone' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="8.2"></circle>
      <path d="M8.2 8.2 15.8 15.8M15.8 8.2 8.2 15.8"></path>
    </svg>
  )
}
{
  name === 'human' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="6.4" r="2.3"></circle>
      <path d="M7 20.5v-2.4c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5v2.4"></path>
    </svg>
  )
}
