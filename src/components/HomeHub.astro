---
import { homeHub, homeTileArt } from '../data/site';
import { getUi, localizePath, resolveLocale } from '../i18n';
import EarthGlobe from './EarthGlobe.astro';
import HubTile from './HubTile.astro';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
---

<section class="home-hub" aria-label={ui.home.heroAria}>
  <div class="wrap home-hub-inner">
    <div class="home-hero-row">
      <div class="home-hero-copy">
        <h1 class="home-hub-kicker">{ui.home.choosePath}</h1>
        <p class="home-hub-slashes" aria-hidden="true">/////</p>
        <p class="home-hub-tagline">{ui.home.tagline}</p>
      </div>
      <EarthGlobe label={ui.home.globeLabel} credit={ui.home.globeCredit} />
    </div>
    <div class="hub-grid">
      {
        homeHub.map((item) => {
          const soon = 'soon' in item && item.soon;
          const image = item.key in homeTileArt ? homeTileArt[item.key as keyof typeof homeTileArt] : undefined;
          return (
            <HubTile
              href={localizePath(item.href, locale)}
              icon={item.icon}
              title={ui.nav[item.key]}
              text={ui.home.tiles[item.key]}
              badge={soon ? ui.comingSoon.badge : undefined}
              image={image}
              tileKey={item.key}
            />
          );
        })
      }
    </div>
  </div>
</section>
