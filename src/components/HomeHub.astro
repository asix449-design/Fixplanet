---
import { homeHub } from '../data/site';
import { getUi, localizePath, resolveLocale } from '../i18n';
import HubTile from './HubTile.astro';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
---

<section class="home-hub" aria-label={ui.home.heroAria}>
  <div class="wrap home-hub-inner">
    <h1 class="home-hub-kicker">{ui.home.choosePath}</h1>
    <div class="hub-grid">
      {
        homeHub.map((item) => {
          const soon = 'soon' in item && item.soon;
          return (
            <HubTile
              href={localizePath(item.href, locale)}
              icon={item.icon}
              title={ui.nav[item.key]}
              text={ui.home.tiles[item.key]}
              badge={soon ? ui.comingSoon.badge : undefined}
            />
          );
        })
      }
    </div>
  </div>
</section>
