---
import { homeHub } from '../data/site';
import { getUi, localizePath, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
---

<section class="home-hub" aria-label={ui.home.heroAria}>
  <div class="wrap home-hub-inner">
    <h1 class="home-hub-kicker">{ui.home.choosePath}</h1>
    <div class="hub-grid">
      {
        homeHub.map((item) => {
          const href = localizePath(item.href, locale);
          const soon = 'soon' in item && item.soon;
          return (
            <a class="hub-tile" href={href}>
              <div class="hub-tile-top">
                <div class="hub-icon" aria-hidden="true">
                  {item.icon === 'leaf' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M5 14.5C5 9.8 9.2 5.2 17 4c.4 4.8-.8 8.8-3.6 11.2 1.8-.6 3.6-2 4.6-4.2.8 2.6.4 5.4-1.4 7.5C15 20.4 12.8 21 11 21c-3.4 0-6-2.7-6-6.5z"></path>
                    </svg>
                  )}
                  {item.icon === 'circuit' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="6.2" cy="6.2" r="1.6"></circle>
                      <circle cx="17.8" cy="6.2" r="1.6"></circle>
                      <circle cx="6.2" cy="17.8" r="1.6"></circle>
                      <circle cx="17.8" cy="17.8" r="1.6"></circle>
                      <path d="M7.8 6.2h8.4M6.2 7.8v8.4M17.8 7.8v8.4M7.8 17.8h8.4"></path>
                      <circle cx="12" cy="12" r="2.1"></circle>
                    </svg>
                  )}
                  {item.icon === 'globe' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="12" cy="12" r="8.2"></circle>
                      <path d="M3.8 12h16.4M12 3.8c2.8 2.8 2.8 13.6 0 16.4M12 3.8c-2.8 2.8-2.8 13.6 0 16.4"></path>
                    </svg>
                  )}
                  {item.icon === 'scales' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M12 4v15M8 20h8M12 6.5 6 13h12L12 6.5z"></path>
                      <path d="M6 13c0 1.8 1.2 2.8 2.8 2.8S11.6 14.8 11.6 13M12.4 13c0 1.8 1.2 2.8 2.8 2.8S18 14.8 18 13"></path>
                    </svg>
                  )}
                  {item.icon === 'paw' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <circle cx="7.2" cy="8.2" r="1.8"></circle>
                      <circle cx="12" cy="6.4" r="1.8"></circle>
                      <circle cx="16.8" cy="8.2" r="1.8"></circle>
                      <ellipse cx="12" cy="15.4" rx="4.1" ry="3.3"></ellipse>
                    </svg>
                  )}
                  {item.icon === 'trees' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 3 6.2 11h3.1L5 17h5v4h4v-4h5l-4.3-6h3.1L12 3z"></path>
                    </svg>
                  )}
                  {item.icon === 'book' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M5 4.5h10.5A3.5 3.5 0 0 1 19 8v12.5H8.5A3.5 3.5 0 0 0 5 17V4.5z"></path>
                      <path d="M5 17a3.5 3.5 0 0 1 3.5-3.5H19"></path>
                    </svg>
                  )}
                  {item.icon === 'compass' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="12" cy="12" r="8.2"></circle>
                      <path d="m14.7 9.3-1.2 4.2-4.2 1.2 1.2-4.2 4.2-1.2z"></path>
                    </svg>
                  )}
                </div>
                {soon && <span class="hub-soon">{ui.comingSoon.badge}</span>}
              </div>
              <h2>{ui.nav[item.key]}</h2>
              <p>{ui.home.tiles[item.key]}</p>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
