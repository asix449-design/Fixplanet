---
import HubIcon, { type HubIconName } from './HubIcon.astro';

interface Props {
  href: string;
  icon: HubIconName;
  title: string;
  text: string;
  badge?: string;
  badgeTone?: 'soon' | 'atlas';
  lead?: boolean;
  active?: boolean;
  dataArea?: string;
  dataStatus?: string;
  dataFilter?: string;
  dataPanel?: string;
}

const {
  href,
  icon,
  title,
  text,
  badge,
  badgeTone = 'soon',
  lead = false,
  active = false,
  dataArea,
  dataStatus,
  dataFilter,
  dataPanel,
} = Astro.props;
---

<a
  class:list={['hub-tile', { 'is-active': active, 'is-lead': lead }]}
  href={href}
  aria-current={active ? 'page' : undefined}
  {...(dataArea ? { 'data-area': dataArea } : {})}
  {...(dataStatus ? { 'data-status': dataStatus } : {})}
  {...(dataFilter ? { 'data-filter': dataFilter } : {})}
  {...(dataPanel ? { 'data-panel': dataPanel } : {})}
>
  <div class="hub-tile-top">
    <div class="hub-icon" aria-hidden="true">
      <HubIcon name={icon} />
    </div>
    {badge && <span class={badgeTone === 'atlas' ? 'hub-atlas-badge' : 'hub-soon'}>{badge}</span>}
  </div>
  <h2>{title}</h2>
  <p>{text}</p>
  <span class="hub-arrow" aria-hidden="true">→</span>
</a>
