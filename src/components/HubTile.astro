---
import HubIcon, { type HubIconName } from './HubIcon.astro';

interface Props {
  href?: string;
  icon: HubIconName;
  title: string;
  text: string;
  badge?: string;
  badgeTone?: 'soon' | 'atlas';
  lead?: boolean;
  active?: boolean;
  dataArea?: string;
  dataStatus?: string;
  dataFilter?: string;
  dataPanel?: string;
}

const {
  href,
  icon,
  title,
  text,
  badge,
  badgeTone = 'soon',
  lead = false,
  active = false,
  dataArea,
  dataStatus,
  dataFilter,
  dataPanel,
} = Astro.props;

const isSoon = Boolean(badge && badgeTone === 'soon' && !href);
const classList = ['hub-tile', { 'is-active': active, 'is-lead': lead, 'is-soon': isSoon }];
const dataAttrs = {
  ...(dataArea ? { 'data-area': dataArea } : {}),
  ...(dataStatus ? { 'data-status': dataStatus } : {}),
  ...(dataFilter ? { 'data-filter': dataFilter } : {}),
  ...(dataPanel ? { 'data-panel': dataPanel } : {}),
};

const inner = (
  <>
    <div class="hub-tile-top">
      <div class="hub-icon" aria-hidden="true">
        <HubIcon name={icon} />
      </div>
      {badge && <span class={badgeTone === 'atlas' ? 'hub-atlas-badge' : 'hub-soon'}>{badge}</span>}
    </div>
    <h2>{title}</h2>
    <p>{text}</p>
    {href && <span class="hub-arrow" aria-hidden="true">→</span>}
  </>
);
---

{
  href ? (
    <a
      class:list={classList}
      href={href}
      aria-current={active ? 'page' : undefined}
      {...dataAttrs}
    >
      {inner}
    </a>
  ) : (
    <article class:list={classList} {...dataAttrs}>
      {inner}
    </article>
  )
}
