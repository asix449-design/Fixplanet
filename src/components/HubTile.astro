---
import HubIcon, { type HubIconName } from './HubIcon.astro';

interface Props {
  href?: string;
  icon: HubIconName;
  title: string;
  text: string;
  badge?: string;
  badgeTone?: 'soon' | 'atlas';
  lead?: boolean;
  active?: boolean;
  image?: string;
  tileKey?: string;
  dataArea?: string;
  dataStatus?: string;
  dataFilter?: string;
  dataPanel?: string;
}

const {
  href,
  icon,
  title,
  text,
  badge,
  badgeTone = 'soon',
  lead = false,
  active = false,
  image,
  tileKey,
  dataArea,
  dataStatus,
  dataFilter,
  dataPanel,
} = Astro.props;

const isSoon = Boolean(badge && badgeTone === 'soon' && !href);
const classList = ['hub-tile', { 'is-active': active, 'is-lead': lead, 'is-soon': isSoon, 'has-art': Boolean(image) }];
const dataAttrs = {
  ...(tileKey ? { 'data-tile': tileKey } : {}),
  ...(dataArea ? { 'data-area': dataArea } : {}),
  ...(dataStatus ? { 'data-status': dataStatus } : {}),
  ...(dataFilter ? { 'data-filter': dataFilter } : {}),
  ...(dataPanel ? { 'data-panel': dataPanel } : {}),
};
const badgeClass = badgeTone === 'atlas' ? 'hub-atlas-badge' : 'hub-soon';
---

{
  href ? (
    <a
      class:list={classList}
      href={href}
      aria-current={active ? 'page' : undefined}
      {...dataAttrs}
    >
      {image && (
        <>
          <img class="hub-tile-art" src={image} alt="" decoding="async" />
          <span class="hub-tile-scrim" aria-hidden="true"></span>
        </>
      )}
      <div class="hub-tile-top">
        <div class="hub-icon" aria-hidden="true">
          <HubIcon name={icon} />
        </div>
        {badge && <span class={badgeClass}>{badge}</span>}
      </div>
      <h2>{title}</h2>
      <p>{text}</p>
      <span class="hub-arrow" aria-hidden="true">→</span>
    </a>
  ) : (
    <article class:list={classList} {...dataAttrs}>
      {image && (
        <>
          <img class="hub-tile-art" src={image} alt="" decoding="async" />
          <span class="hub-tile-scrim" aria-hidden="true"></span>
        </>
      )}
      <div class="hub-tile-top">
        <div class="hub-icon" aria-hidden="true">
          <HubIcon name={icon} />
        </div>
        {badge && <span class={badgeClass}>{badge}</span>}
      </div>
      <h2>{title}</h2>
      <p>{text}</p>
    </article>
  )
}
