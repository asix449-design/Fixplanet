---
import { site } from '../data/site';
import { basedIn, getUi, localizePath, resolveLocale } from '../i18n';
import Logo from './Logo.astro';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Logo />
        <p style="margin-top: 0.9rem; max-width: 28rem;">
          {ui.footer.blurb}
        </p>
      </div>
      <div>
        <div class="footer-title">{ui.footer.explore}</div>
        <div class="footer-links">
          <a href={localizePath('/solutions', locale)}>{ui.nav.solutions}</a>
          <a href={localizePath('/innovations', locale)}>{ui.nav.innovations}</a>
          <a href={localizePath('/maps', locale)}>{ui.nav.maps}</a>
          <a href={localizePath('/wildlife', locale)}>{ui.nav.wildlife}</a>
          <a href={localizePath('/forests', locale)}>{ui.nav.forests}</a>
          <a href={localizePath('/oceans', locale)}>{ui.nav.oceans}</a>
          <a href={localizePath('/law', locale)}>{ui.nav.law}</a>
          <a href={localizePath('/book', locale)}>{ui.footer.theBook}</a>
          <a href={localizePath('/about', locale)}>{ui.nav.about}</a>
          <a href={localizePath('/donate', locale)}>{ui.nav.donate}</a>
        </div>
      </div>
    </div>
    <div class="footer-meta">
      <span>{basedIn(locale)}</span>
      <span>
        <a href={site.twitter} rel="noopener noreferrer">{site.twitterHandle}</a>
        · © {year} {site.name}
      </span>
    </div>
  </div>
</footer>
