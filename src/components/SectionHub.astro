---
interface Props {
  kicker: string;
  label: string;
  columns?: 3 | 4;
  kickerTag?: 'h1' | 'h2';
}

const { kicker, label, columns = 4, kickerTag: KickerTag = 'h1' } = Astro.props;
---

<section class="section-hub" aria-label={label}>
  <div class="wrap home-hub-inner">
    <KickerTag class="home-hub-kicker">{kicker}</KickerTag>
    <div class:list={['hub-grid', { 'hub-grid-3': columns === 3 }]}>
      <slot />
    </div>
  </div>
</section>
