---
interface Props {
  kicker: string;
  label: string;
  columns?: 3 | 4;
}

const { kicker, label, columns = 4 } = Astro.props;
---

<section class="section-hub" aria-label={label}>
  <div class="wrap home-hub-inner">
    <h1 class="home-hub-kicker">{kicker}</h1>
    <div class:list={['hub-grid', { 'hub-grid-3': columns === 3 }]}>
      <slot />
    </div>
  </div>
</section>
