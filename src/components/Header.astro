---
import { nav } from '../data/site';
import { getUi, localizePath, resolveLocale, stripLocalePrefix } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const current = stripLocalePrefix(Astro.url.pathname.replace(/\/$/, '') || '/');
---

<header class="site-header">
  <div class="wrap header-inner">
    <Logo />
    <nav id="site-nav" class="nav" aria-label={ui.primaryNav}>
      {
        nav.map((item) => {
          const href = localizePath(item.href, locale);
          const active =
            item.href === '/'
              ? current === '/'
              : current === item.href || current.startsWith(`${item.href}/`);
          return (
            <a href={href} aria-current={active ? 'page' : undefined}>
              {ui.nav[item.key]}
            </a>
          );
        })
      }
      <div class="lang-switch-mobile">
        <LanguageSwitcher />
      </div>
    </nav>
    <div class="header-tools">
      <a class="header-donate" href={localizePath('/donate', locale)}>
        {ui.nav.donate}
      </a>
      <div class="lang-switch-bar">
        <LanguageSwitcher />
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span></span>
        <span class="visually-hidden">{ui.menu}</span>
      </button>
    </div>
  </div>
</header>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
