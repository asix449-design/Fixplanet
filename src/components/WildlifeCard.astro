---
import type { Species } from '../data/wildlife';
import { wildlifeImageSrc, wildlifePrimarySource } from '../data/wildlife';
import { getUi, localizePath, resolveLocale } from '../i18n';

interface Props {
  species: Species;
}

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const { species } = Astro.props;
const href = localizePath(`/wildlife/${species.slug}`, locale);
const iucnLabel = ui.wildlifePage.iucn[species.iucn];
const emphasizeIucn = species.iucn === 'EW' || species.functionallyExtinct === true;
const primary = wildlifePrimarySource(species.primarySources);
---

<article
  class:list={['wildlife-card-wrap', primary && 'innovation-card-wrap']}
  data-wildlife-status={species.status}
  data-slug={species.slug}
>
  <a class="wildlife-card" href={href}>
    <div class="card-art">
      <img
        src={wildlifeImageSrc(species.image)}
        alt={species.imageAlt}
        width="640"
        height="400"
        loading="lazy"
      />
    </div>
    <div class="card-body">
      <div class="innovation-badges">
        {
          emphasizeIucn ? (
            <>
              <span class:list={['tag', `status-${species.status}`]}>{species.iucn}</span>
              <span class:list={['tag', `status-${species.status}`]}>{iucnLabel}</span>
            </>
          ) : (
            <span class:list={['tag', `status-${species.status}`]}>
              {ui.wildlifePage.status[species.status]}
            </span>
          )
        }
        {
          species.functionallyExtinct ? (
            <span class="tag status-extinct">{ui.wildlifePage.functionallyExtinct}</span>
          ) : null
        }
      </div>
      <h3>{species.commonName}</h3>
      <p class="scientific-name"><em>{species.scientificName}</em></p>
      <p class="wildlife-hook">{species.hook}</p>
      <span class="card-cta">{ui.wildlifePage.cardCta}</span>
    </div>
  </a>
  {
    primary && (
      <p class="innovation-card-source">
        <a href={primary.url} rel="noopener noreferrer">
          {ui.wildlifePage.primarySource}: {primary.label}
        </a>
      </p>
    )
  }
</article>
