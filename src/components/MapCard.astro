---
import { mapPreviewSrc, mapPrimarySource, type MapEntry } from '../data/maps';
import { getMapsPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  map: MapEntry;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getMapsPage(locale);
const { map } = Astro.props;
const href = localizePath(`/maps/${map.slug}`, locale);
const preview = mapPreviewSrc(map.preview);
const primary = mapPrimarySource(map);
const cta = map.category === 'climate' ? page.cardCta.replace(/\s*→\s*$/, '') : page.cardCta;
---

<article
  class:list={['map-card-wrap', primary && 'innovation-card-wrap']}
  data-map-category={map.category}
  data-slug={map.slug}
>
  <a class="map-card" href={href}>
    <div
      class:list={['card-art', 'map-card-art', map.fit === 'contain' && 'map-card-art-contain']}
      style={map.frameColor ? `background:${map.frameColor}` : undefined}
    >
      <img
        src={preview}
        alt={map.imageAlt}
        width={map.previewWidth ?? 640}
        height={map.previewHeight ?? 320}
        loading="lazy"
        style={map.frameColor ? `background:${map.frameColor}` : undefined}
      />
      {
        map.previewKind === 'schematic' ? (
          <span class="map-schematic-badge">{page.schematicBadge}</span>
        ) : null
      }
    </div>
    <div class="card-body">
      <span class="tag">{page.categories[map.category]}</span>
      <h3>{map.title}</h3>
      <p class="map-card-meta">
        {
          map.cardMeta ? (
            map.cardMeta
          ) : (
            <>
              {map.sourceShort}
              <span aria-hidden="true"> · </span>
              {map.year}
            </>
          )
        }
      </p>
      <p class="wildlife-hook">{map.hook}</p>
      <span class="card-cta">{cta}</span>
    </div>
  </a>
  {
    primary ? (
      <p class="innovation-card-source">
        <a href={primary.url} rel="noopener noreferrer">
          {page.sourceLabel}: {map.gridSourceLabel ?? primary.label}
        </a>
      </p>
    ) : null
  }
</article>
