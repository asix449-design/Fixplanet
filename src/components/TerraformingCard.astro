---
import type { GeoProject } from '../data/terraforming';
import { geoDetailPath, geoImageSrc, geoPrimarySource } from '../data/terraforming';
import { getGeoPage, localizePath, resolveLocale } from '../i18n';

interface Props {
  item: GeoProject;
}

const locale = resolveLocale(Astro.currentLocale);
const page = getGeoPage(locale);
const { item } = Astro.props;
const href = localizePath(geoDetailPath(item.slug), locale);
const primary =
  item.shelf === 'desert' ? (item.gridSource ?? geoPrimarySource(item.sources)) : undefined;
const natural = item.image.fit === 'natural';
---

<article
  class="wildlife-card-wrap innovation-card-wrap"
  data-geo-shelf={item.shelf}
  data-slug={item.slug}
>
  <a class:list={['wildlife-card', 'geo-card', `geo-card-${item.status}`]} href={href}>
    <div class:list={['card-art', natural && 'geo-card-natural']}>
      <img
        src={geoImageSrc(item.image)}
        alt={item.imageAlt}
        width={item.image.width ?? 640}
        height={item.image.height ?? 400}
        loading="lazy"
      />
    </div>
    <div class="card-body">
      <div class="innovation-badges">
        <span class="tag">{item.jurisdiction}</span>
        <span class:list={['tag', `status-${item.status}`]}>
          {page.status[item.status]}
        </span>
      </div>
      <h3>{item.title}</h3>
      <p class="scientific-name">{item.yearStatus}</p>
      <p class="wildlife-hook">{item.hook}</p>
      <span class="card-cta">{page.cardCta}</span>
    </div>
  </a>
  {
    primary && (
      <p class="innovation-card-source">
        <a href={primary.url} rel="noopener noreferrer">
          {page.primarySource}: {primary.label}
        </a>
      </p>
    )
  }
</article>
