---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="Fix Planet home">
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="16" fill="#1B7A4E"></circle>
    <path
      fill="#F4F7F2"
      d="M16.2 7.2c4.6 1.1 7.6 4.8 7.3 9.3-.3 3.6-2.6 6.4-5.8 7.6 1.4-2.1 1.7-4.7.7-7.1-1.1-2.6-3.4-4.3-6.2-4.8 1.2-2.8 2.6-4.2 4-5z"
    ></path>
    <path
      fill="#F4F7F2"
      d="M10.4 13.6c2.9.4 5.1 2.2 6.1 4.8 1 2.5.6 5.1-.9 7.1-3.6-1.4-6.1-4.6-6.1-8.4 0-1.2.3-2.4.9-3.5z"
      opacity="0.85"></path>
    <path
      stroke="#1B7A4E"
      stroke-width="1.4"
      stroke-linecap="round"
      d="M15.2 16.2c0 3.4-.2 6.4-.8 8.6"></path>
  </svg>
  <span>Fix Planet</span>
</a>
