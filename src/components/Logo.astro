---
import { getUi, localizePath, resolveLocale } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
---

<a
  href={localizePath('/', locale)}
  class:list={['logo', className]}
  aria-label={ui.homeAria}
>
  <img
    class="logo-mark"
    src="/images/brand/logo-mark.svg"
    alt=""
    width="40"
    height="40"
  />
  <span class="logo-wordmark" aria-hidden="true">
    <span class="logo-fix">FIX</span>
    <span class="logo-planet">PLANET</span>
  </span>
</a>
