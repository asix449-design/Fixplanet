---
interface Props {
  tag: string;
  slug: string;
}

const { tag, slug } = Astro.props;

const palettes: Record<string, { from: string; to: string; mid: string }> = {
  Water: { from: '#8fd4c4', to: '#1b7a4e', mid: '#3fa36a' },
  Forests: { from: '#9ad07a', to: '#14603c', mid: '#3fa36a' },
  Waste: { from: '#c6d46e', to: '#1b7a4e', mid: '#6aa84f' },
  Cities: { from: '#b8c9a8', to: '#1b7a4e', mid: '#5a8f6a' },
  Materials: { from: '#d4c79a', to: '#3d6b4a', mid: '#8aa36a' },
  Oceans: { from: '#7ec8d4', to: '#14605a', mid: '#2f8f8a' },
  Energy: { from: '#f0d56a', to: '#1b7a4e', mid: '#e0a83a' },
};

const p = palettes[tag] ?? palettes.Water;
---

<div class="card-art" aria-hidden="true">
  <svg viewBox="0 0 400 160" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={`g-${slug}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={p.from}></stop>
        <stop offset="100%" stop-color={p.to}></stop>
      </linearGradient>
    </defs>
    <rect width="400" height="160" fill={`url(#g-${slug})`}></rect>

    {
      tag === 'Water' && (
        <>
          <path d="M0 110 C60 90 90 130 160 108 C230 86 260 128 400 96 V160 H0 Z" fill="rgba(255,255,255,.22)"></path>
          <path d="M0 128 C80 112 120 142 200 126 C280 110 320 144 400 122 V160 H0 Z" fill="rgba(255,255,255,.16)"></path>
          <ellipse cx="310" cy="48" rx="28" ry="36" fill="rgba(255,255,255,.35)"></ellipse>
        </>
      )
    }
    {
      tag === 'Forests' && (
        <>
          <polygon points="70,150 120,40 170,150" fill="rgba(20,34,26,.28)"></polygon>
          <polygon points="150,150 210,22 270,150" fill="rgba(20,34,26,.38)"></polygon>
          <polygon points="240,150 300,50 360,150" fill="rgba(20,34,26,.24)"></polygon>
        </>
      )
    }
    {
      tag === 'Waste' && (
        <>
          <circle cx="200" cy="80" r="42" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="8"></circle>
          <path d="M200 38 l12 18 h-24 z" fill="rgba(255,255,255,.7)"></path>
          <path d="M236 100 l-20 8 12-18 z" fill="rgba(255,255,255,.7)"></path>
          <path d="M164 100 l8-20 12 18 z" fill="rgba(255,255,255,.7)"></path>
        </>
      )
    }
    {
      tag === 'Cities' && (
        <>
          <rect x="70" y="70" width="50" height="90" fill="rgba(255,255,255,.28)"></rect>
          <rect x="130" y="40" width="64" height="120" fill="rgba(255,255,255,.38)"></rect>
          <rect x="204" y="58" width="46" height="102" fill="rgba(255,255,255,.3)"></rect>
          <rect x="260" y="78" width="70" height="82" fill="rgba(255,255,255,.22)"></rect>
          <circle cx="330" cy="36" r="16" fill="rgba(255,255,255,.55)"></circle>
        </>
      )
    }
    {
      tag === 'Materials' && (
        <>
          <rect x="80" y="50" width="70" height="70" rx="6" fill="rgba(255,255,255,.28)" transform="rotate(-8 115 85)"></rect>
          <rect x="170" y="40" width="80" height="80" rx="6" fill="rgba(255,255,255,.4)"></rect>
          <rect x="250" y="62" width="64" height="64" rx="6" fill="rgba(255,255,255,.25)" transform="rotate(10 282 94)"></rect>
        </>
      )
    }
    {
      tag === 'Oceans' && (
        <>
          <path d="M0 88 C50 70 80 106 140 88 C200 70 230 108 300 86 C360 68 380 96 400 84 V160 H0 Z" fill="rgba(255,255,255,.2)"></path>
          <path d="M0 118 C70 100 110 136 190 116 C270 96 310 138 400 114 V160 H0 Z" fill="rgba(255,255,255,.16)"></path>
          <ellipse cx="86" cy="62" rx="18" ry="10" fill="rgba(255,255,255,.4)"></ellipse>
        </>
      )
    }
    {
      tag === 'Energy' && (
        <>
          <circle cx="300" cy="42" r="22" fill="rgba(255,255,255,.55)"></circle>
          <rect x="60" y="88" width="90" height="44" transform="skewX(-18)" fill="rgba(20,34,26,.28)"></rect>
          <rect x="150" y="78" width="90" height="44" transform="skewX(-18)" fill="rgba(20,34,26,.36)"></rect>
          <rect x="240" y="94" width="90" height="44" transform="skewX(-18)" fill="rgba(20,34,26,.22)"></rect>
        </>
      )
    }
  </svg>
</div>
