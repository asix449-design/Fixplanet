---
import { mapShelfRedirect } from '../data/maps';
import { localizePath, resolveLocale } from '../i18n';
import MapsView from '../views/MapsView.astro';

const locale = resolveLocale(Astro.currentLocale);
const dest = mapShelfRedirect(Astro.url.searchParams.get('category'));
if (dest) {
  return Astro.redirect(localizePath(dest, locale), dest === '/maps' ? 301 : 301);
}
---

<MapsView hub />
