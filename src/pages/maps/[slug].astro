---
import { HISTORY_OF_BORDERS_SLUG } from '../../data/border-history';
import { isMapCategory, mapCategoryKeys, mapMeta } from '../../data/maps';
import { getMapBySlug, resolveLocale } from '../../i18n';
import HistoryOfBordersView from '../../views/HistoryOfBordersView.astro';
import MapDetailView from '../../views/MapDetailView.astro';
import MapsView from '../../views/MapsView.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'all' } },
    ...mapCategoryKeys.map((slug) => ({ params: { slug } })),
    ...mapMeta.map((item) => ({ params: { slug: item.slug } })),
  ];
}

const { slug } = Astro.params;
const locale = resolveLocale(Astro.currentLocale);
const map = slug && !isMapCategory(slug) ? getMapBySlug(locale, slug) : undefined;
---

{
  slug === 'all' ? (
    <MapsView category="all" />
  ) : slug === HISTORY_OF_BORDERS_SLUG ? (
    <HistoryOfBordersView />
  ) : isMapCategory(slug) ? (
    <MapsView category={slug} />
  ) : (
    map && <MapDetailView map={map} />
  )
}
