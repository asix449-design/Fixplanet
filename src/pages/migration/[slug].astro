---
import {
  isMigrationShelf,
  migrationEntryMeta,
  migrationPathRedirects,
  migrationShelfKeys,
} from '../../data/migration';
import {
  isMissingMigrantId,
  missingMigrantIds,
  missingMigrantsShelfSlug,
} from '../../data/missing-migrants';
import { isRemittanceId, remittanceIds } from '../../data/remittances';
import { getMigrationBySlug, localizePath, resolveLocale } from '../../i18n';
import MigrationDetailView from '../../views/MigrationDetailView.astro';
import MigrationView from '../../views/MigrationView.astro';
import MissingMigrantDetailView from '../../views/MissingMigrantDetailView.astro';
import MissingMigrantsView from '../../views/MissingMigrantsView.astro';
import RemittanceDetailView from '../../views/RemittanceDetailView.astro';
import RemittancesView from '../../views/RemittancesView.astro';

export function getStaticPaths() {
  return [
    ...migrationShelfKeys.map((slug) => ({ params: { slug } })),
    ...migrationEntryMeta.map((item) => ({ params: { slug: item.slug } })),
    ...Object.keys(migrationPathRedirects).map((slug) => ({ params: { slug } })),
    { params: { slug: 'remittances' } },
    ...remittanceIds.map((slug) => ({ params: { slug } })),
    { params: { slug: missingMigrantsShelfSlug } },
    ...missingMigrantIds.map((slug) => ({ params: { slug } })),
  ];
}

const { slug } = Astro.params;
const locale = resolveLocale(Astro.currentLocale);
if (slug && slug in migrationPathRedirects) {
  return Astro.redirect(localizePath(migrationPathRedirects[slug], locale), 301);
}
const item = slug && !isMigrationShelf(slug) ? getMigrationBySlug(locale, slug) : undefined;
---

{
  slug === 'remittances' ? (
    <RemittancesView />
  ) : isRemittanceId(slug) ? (
    <RemittanceDetailView slug={slug} />
  ) : slug === missingMigrantsShelfSlug ? (
    <MissingMigrantsView />
  ) : isMissingMigrantId(slug) ? (
    <MissingMigrantDetailView slug={slug} />
  ) : isMigrationShelf(slug) ? (
    <MigrationView shelf={slug} />
  ) : (
    item && <MigrationDetailView item={item} />
  )
}
