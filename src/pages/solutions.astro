---
import { isSolutionTag } from '../data/solutions';
import { localizePath, resolveLocale } from '../i18n';
import SolutionsView from '../views/SolutionsView.astro';

const locale = resolveLocale(Astro.currentLocale);
const tagParam = Astro.url.searchParams.get('tag');
if (tagParam === 'all' || isSolutionTag(tagParam ?? undefined)) {
  return Astro.redirect(localizePath(`/solutions/${tagParam}`, locale));
}
---

<SolutionsView hub />
