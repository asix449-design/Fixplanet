---
import { geoMeta, geoShelfKeys, isGeoShelf } from '../../data/terraforming';
import { getGeoBySlug, resolveLocale } from '../../i18n';
import TerraformingDetailView from '../../views/TerraformingDetailView.astro';
import TerraformingView from '../../views/TerraformingView.astro';

export function getStaticPaths() {
  return [
    ...geoShelfKeys.map((slug) => ({ params: { slug } })),
    ...geoMeta.map((item) => ({ params: { slug: item.slug } })),
  ];
}

const { slug } = Astro.params;
const locale = resolveLocale(Astro.currentLocale);
const item = slug && !isGeoShelf(slug) ? getGeoBySlug(locale, slug) : undefined;
---

{
  isGeoShelf(slug) ? (
    <TerraformingView shelf={slug} />
  ) : (
    item && <TerraformingDetailView item={item} />
  )
}
