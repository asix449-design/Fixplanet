---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="New World — Fix Planet"
  description="New World by Aigars Abramovics: a clear look at what’s broken on our planet — and what we can still fix."
>
  <header class="page-hero">
    <div class="wrap">
      <div class="eyebrow">The book</div>
      <h1>New World</h1>
      <p>By Aigars Abramovics</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap book-layout">
      <div class="book-cover" aria-hidden="true">
        <div class="book-cover-kicker">Fix Planet</div>
        <h2>New World</h2>
        <p>Aigars Abramovics</p>
      </div>
      <div class="prose">
        <p>
          A clear look at what’s broken on our planet — and what we can still
          fix: technologies, laws, and the choices that scale.
        </p>
        <div class="meta-row">
          <span class="pill">Status: Available</span>
        </div>
        <h2>Inside</h2>
        <ul class="inside-list">
          <li>Pressures on water, forests, climate, and wildlife</li>
          <li>Solutions that already exist, not slogans</li>
          <li>Ideas for rules and habits that protect nature</li>
        </ul>
        <a
          class="btn btn-primary"
          href={site.bookAmazon}
          rel="noopener noreferrer"
        >
          Buy on Amazon →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
