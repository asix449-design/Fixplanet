---
import {
  isWildlifeStatus,
  speciesMeta,
  wildlifeStatusKeys,
} from '../../data/wildlife';
import { getWildlifeBySlug, resolveLocale } from '../../i18n';
import WildlifeSpeciesView from '../../views/WildlifeSpeciesView.astro';
import WildlifeView from '../../views/WildlifeView.astro';

export function getStaticPaths() {
  return [
    ...wildlifeStatusKeys.map((slug) => ({ params: { slug } })),
    ...speciesMeta.map((item) => ({ params: { slug: item.slug } })),
  ];
}

const { slug } = Astro.params;
const locale = resolveLocale(Astro.currentLocale);
const species = slug && !isWildlifeStatus(slug) ? getWildlifeBySlug(locale, slug) : undefined;
---

{
  isWildlifeStatus(slug) ? (
    <WildlifeView status={slug} />
  ) : (
    species && <WildlifeSpeciesView species={species} />
  )
}
