---
import { isOceanAtlas, oceanAtlasSlugs } from '../../data/ocean-atlas';
import { isOceanPanel, oceanPanelKeys } from '../../data/oceans';
import OceanAtlasDetailView from '../../views/OceanAtlasDetailView.astro';
import OceansView from '../../views/OceansView.astro';

export function getStaticPaths() {
  return [...oceanPanelKeys, ...oceanAtlasSlugs].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

{
  isOceanAtlas(slug) ? (
    <OceanAtlasDetailView slug={slug} />
  ) : (
    <OceansView panel={isOceanPanel(slug) ? slug : 'currents'} />
  )
}
