---
import { isMapCategory } from '../../data/maps';
import { localeStaticPaths } from '../../i18n';
import MapsView from '../../views/MapsView.astro';

export const getStaticPaths = localeStaticPaths;

const categoryParam = Astro.url.searchParams.get('category');
const category = isMapCategory(categoryParam ?? undefined) ? categoryParam : 'all';
---

<MapsView category={category} />
