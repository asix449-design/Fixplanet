---
import { isMapCategory } from '../../data/maps';
import { localeStaticPaths, localizePath, resolveLocale } from '../../i18n';
import MapsView from '../../views/MapsView.astro';

export const getStaticPaths = localeStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const categoryParam = Astro.url.searchParams.get('category');
if (categoryParam === 'all' || isMapCategory(categoryParam ?? undefined)) {
  return Astro.redirect(localizePath(`/maps/${categoryParam}`, locale));
}
---

<MapsView hub />
