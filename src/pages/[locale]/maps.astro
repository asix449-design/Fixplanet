---
import { mapShelfRedirect } from '../../data/maps';
import { localeStaticPaths, localizePath, resolveLocale } from '../../i18n';
import MapsView from '../../views/MapsView.astro';

export const getStaticPaths = localeStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const dest = mapShelfRedirect(Astro.url.searchParams.get('category'));
if (dest) {
  return Astro.redirect(localizePath(dest, locale), 301);
}
---

<MapsView hub />
