---
import { geoMeta, geoShelfKeys } from '../../../data/terraforming';
import { otherLocales } from '../../../i18n';

export function getStaticPaths() {
  return otherLocales.flatMap((locale) => [
    ...geoShelfKeys.map((slug) => ({ params: { locale, slug } })),
    ...geoMeta.map((item) => ({ params: { locale, slug: item.slug } })),
  ]);
}

const { locale, slug } = Astro.params;
return Astro.redirect(`/${locale}/terraforming/${slug}`, 301);
---
