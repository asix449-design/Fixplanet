---
import {
  isLawCategory,
  isLawStatus,
  lawCategoryKeys,
  lawStatusKeys,
} from '../../../../data/law';
import { otherLocales } from '../../../../i18n';
import LawCategoryView from '../../../../views/LawCategoryView.astro';

export function getStaticPaths() {
  return otherLocales.flatMap((locale) =>
    lawCategoryKeys.flatMap((category) =>
      lawStatusKeys.map((status) => ({ params: { locale, category, status } })),
    ),
  );
}

const { category, status } = Astro.params;
---

{
  isLawCategory(category) && isLawStatus(status) ? (
    <LawCategoryView category={category} status={status} />
  ) : null
}
