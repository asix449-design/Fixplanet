---
import { isInnovationArea } from '../../data/innovations';
import { localeStaticPaths, localizePath, resolveLocale } from '../../i18n';
import InnovationsView from '../../views/InnovationsView.astro';

export const getStaticPaths = localeStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const areaParam = Astro.url.searchParams.get('area');
if (isInnovationArea(areaParam ?? undefined)) {
  return Astro.redirect(localizePath(`/innovations/${areaParam}`, locale));
}
---

<InnovationsView hub />
