---
import { isInnovationArea } from '../../data/innovations';
import { localeStaticPaths } from '../../i18n';
import InnovationsView from '../../views/InnovationsView.astro';

export const getStaticPaths = localeStaticPaths;

const areaParam = Astro.url.searchParams.get('area');
const area = isInnovationArea(areaParam ?? undefined) ? areaParam : 'all';
---

<InnovationsView area={area} />
