---
import {
  isWildlifeHubKey,
  speciesMeta,
  wildlifeHubKeys,
} from '../../../data/wildlife';
import { getWildlifeBySlug, otherLocales, resolveLocale } from '../../../i18n';
import WildlifeSpeciesView from '../../../views/WildlifeSpeciesView.astro';
import WildlifeView from '../../../views/WildlifeView.astro';

export function getStaticPaths() {
  return otherLocales.flatMap((locale) => [
    ...wildlifeHubKeys.map((slug) => ({ params: { locale, slug } })),
    ...speciesMeta.map((item) => ({ params: { locale, slug: item.slug } })),
  ]);
}

const { slug } = Astro.params;
const locale = resolveLocale(Astro.currentLocale);
const species = slug && !isWildlifeHubKey(slug) ? getWildlifeBySlug(locale, slug) : undefined;
---

{
  isWildlifeHubKey(slug) ? (
    <WildlifeView shelf={slug} />
  ) : (
    species && <WildlifeSpeciesView species={species} />
  )
}
