---
import { isGeoShelf } from '../../data/terraforming';
import { localeStaticPaths, localizePath, resolveLocale } from '../../i18n';
import TerraformingView from '../../views/TerraformingView.astro';

export const getStaticPaths = localeStaticPaths;

const locale = resolveLocale(Astro.currentLocale);
const shelfParam = Astro.url.searchParams.get('shelf');
if (isGeoShelf(shelfParam ?? undefined)) {
  return Astro.redirect(localizePath(`/terraforming/${shelfParam}`, locale));
}
---

<TerraformingView hub />
