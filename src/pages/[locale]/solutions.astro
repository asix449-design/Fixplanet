---
import { isSolutionTag } from '../../data/solutions';
import { localeStaticPaths } from '../../i18n';
import SolutionsView from '../../views/SolutionsView.astro';

export const getStaticPaths = localeStaticPaths;

const tagParam = Astro.url.searchParams.get('tag');
const tag = isSolutionTag(tagParam ?? undefined) ? tagParam : 'all';
---

<SolutionsView tag={tag} />
