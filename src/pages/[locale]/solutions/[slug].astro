---
import { isSolutionTag, tagKeys } from '../../../data/solutions';
import { otherLocales } from '../../../i18n';
import SolutionsView from '../../../views/SolutionsView.astro';

export function getStaticPaths() {
  return otherLocales.flatMap((locale) =>
    ['all', ...tagKeys].map((slug) => ({ params: { locale, slug } })),
  );
}

const { slug } = Astro.params;
---

{(slug === 'all' || isSolutionTag(slug)) && <SolutionsView tag={slug} />}
