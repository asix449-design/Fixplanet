---
import {
  geoMeta,
  geoPathRedirects,
  geoShelfKeys,
  isGeoShelf,
} from '../../../data/terraforming';
import { getGeoBySlug, localizePath, otherLocales, resolveLocale } from '../../../i18n';
import TerraformingDetailView from '../../../views/TerraformingDetailView.astro';
import TerraformingView from '../../../views/TerraformingView.astro';

export function getStaticPaths() {
  return otherLocales.flatMap((locale) => [
    ...geoShelfKeys.map((slug) => ({ params: { locale, slug } })),
    ...geoMeta.map((item) => ({ params: { locale, slug: item.slug } })),
    ...Object.keys(geoPathRedirects).map((slug) => ({ params: { locale, slug } })),
  ]);
}

const { slug } = Astro.params;
const locale = resolveLocale(Astro.currentLocale);
if (slug && slug in geoPathRedirects) {
  return Astro.redirect(localizePath(geoPathRedirects[slug], locale), 301);
}
const item = slug && !isGeoShelf(slug) ? getGeoBySlug(locale, slug) : undefined;
---

{
  isGeoShelf(slug) ? (
    <TerraformingView shelf={slug} />
  ) : (
    item && <TerraformingDetailView item={item} />
  )
}
