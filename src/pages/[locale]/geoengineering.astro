---
import { isGeoShelf } from '../../data/geoengineering';
import { localeStaticPaths } from '../../i18n';
import GeoengineeringView from '../../views/GeoengineeringView.astro';

export const getStaticPaths = localeStaticPaths;

const shelfParam = Astro.url.searchParams.get('shelf');
const shelf = isGeoShelf(shelfParam ?? undefined) ? shelfParam : 'all';
---

<GeoengineeringView shelf={shelf} />
