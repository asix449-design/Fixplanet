---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="About — Fix Planet"
  description="Fix Planet is curated by Aigars Abramovics: practical ways to heal water, forests, energy, waste, wildlife, and the rules that protect them."
>
  <header class="page-hero">
    <div class="wrap">
      <div class="eyebrow">The project</div>
      <h1>About Fix Planet</h1>
      <p>
        Practical ways to heal the systems we depend on — collected, paired
        with proof, and kept honest.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap about-grid">
      <div class="prose">
        <p>
          Fix Planet collects practical ways to heal the systems we depend on:
          water, forests, energy, waste, wildlife, and the rules that protect
          them.
        </p>
        <p>
          We pair each problem with a technology or approach that already works
          — then point to proof. The project is curated by
          <strong>Aigars Abramovics</strong>, an investor and writer focused on
          green technology and a livable future.
        </p>
        <p>
          The longer argument lives in the <a href="/book">Book</a>. Day-to-day
          ideas also appear on X as
          <a href={site.twitter} rel="noopener noreferrer">{site.twitterHandle}</a>.
        </p>
        <p>Based in {site.location}.</p>
      </div>
      <aside class="curator">
        <div class="curator-top">
          <img
            class="curator-photo"
            src="/images/aigars-abramovics.jpg"
            alt="Aigars Abramovics"
            width="800"
            height="800"
          />
          <div>
            <div class="curator-label">Curator</div>
            <h2>Aigars Abramovics</h2>
          </div>
        </div>
        <p>
          Investor and writer focused on green technology and a livable future.
        </p>
        <p style="margin-top: 1rem;">
          <a class="text-link" href={site.twitter} rel="noopener noreferrer">
            Follow {site.twitterHandle} →
          </a>
        </p>
        <p>
          <a class="text-link" href="/book">Read New World →</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
