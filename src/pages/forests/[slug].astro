---
import { forestAtlasSlugs, isForestAtlas } from '../../data/forest-atlas';
import { forestPanelKeys, isForestPanel } from '../../data/forests';
import ForestAtlasDetailView from '../../views/ForestAtlasDetailView.astro';
import ForestsView from '../../views/ForestsView.astro';

export function getStaticPaths() {
  return [...forestPanelKeys, ...forestAtlasSlugs].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

{
  isForestAtlas(slug) ? (
    <ForestAtlasDetailView slug={slug} />
  ) : (
    <ForestsView panel={isForestPanel(slug) ? slug : 'satellite'} />
  )
}
