{
  "name": "fix-planet",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Fix Planet — a living atlas of technologies that repair the planet.",
  "scripts": {
    "dev": "astro dev --host",
    "build": "node scripts/copy-maplibre-worker.mjs && astro build",
    "fetch:hazards": "node scripts/fetch-hazards.mjs",
    "fetch:economy": "node scripts/fetch-economy.mjs",
    "check:economy": "node scripts/check-economy.mjs",
    "test:economy": "node --test scripts/economy/economy.test.mjs",
    "preview": "astro preview --host",
    "astro": "astro"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.5.1",
    "astro": "^5.13.7",
    "maplibre-gl": "^6.11.2",
    "three": "^0.170.0"
  }
}
